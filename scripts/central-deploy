#!/usr/bin/env bash
set -euo pipefail

# Bring a merged config change live on the central SkyEye host.
#
# Run on monitoring-prod from the SkyEye checkout (/home/ubuntu/SkyEye):
#   scripts/central-deploy --dry-run   # fetch + validate the target commit only
#   scripts/central-deploy             # validate, fast-forward, reload, confirm
#   scripts/central-deploy --status    # show reload health and live inventory
#
# Validation runs on a temporary worktree of the target commit BEFORE the live
# checkout moves, using the image tags pinned in that commit's compose file, so
# a failed check changes nothing. Dashboards and Loki rules are validated there
# too, the rules by the real ruler of the pinned Loki image in a throwaway,
# networkless container. Only hot-reloadable paths are deployed; a change that
# needs a container recreate is refused and must be done by hand.
#
# Publishing is not the same as loading: after the checkout moves, Loki and
# Grafana keep serving their old content when they reject a file, and neither
# has a reload that reports it. So a changed rule or dashboard must be seen
# loaded through their APIs before the commit counts as applied. If it is not,
# the run fails with the checkout left at the target, nothing recorded and no
# automatic rollback: Prometheus and Alertmanager already run that commit, and
# undoing them is the operator's call.
#
# Reading dashboards back takes a Grafana service account token with the Viewer
# role, in GRAFANA_TOKEN_FILE outside the checkout. A dashboard change without a
# working token fails before the checkout moves, in a dry run too.
#
# The last commit that was validated, reloaded AND confirmed loaded is recorded
# in .git/skyeye-central-deploy.applied. A run whose checkout is already at the
# target but not recorded (a failed reload, a load that was not confirmed, or a
# checkout updated by git pull) validates, reloads and confirms it again, so
# rerunning the command is always the retry.
# Everything that differs from HEAD or from that record counts as not yet live,
# so a recreate-only change pulled by hand is refused too. After applying such a
# change by hand, `--manual-applied SHA` (the target commit, with the checkout
# already there) records it once validation, reloads and confirmation pass.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
REMOTE=origin
BRANCH=master
MODE=deploy
MANUAL_APPLIED=""
DOCKER_BIN="${SKYEYE_DOCKER:-docker}"
CURL_BIN="${SKYEYE_CURL:-curl}"
PROM_URL="${SKYEYE_PROM_URL:-http://127.0.0.1:9090}"
AM_URL="${SKYEYE_AM_URL:-http://127.0.0.1:9093}"
LOKI_URL="${SKYEYE_LOKI_URL:-http://127.0.0.1:3100}"
GRAFANA_URL="${SKYEYE_GRAFANA_URL:-http://127.0.0.1:3000}"
GRAFANA_TOKEN_FILE="${SKYEYE_GRAFANA_TOKEN_FILE:-/home/ubuntu/.config/skyeye/grafana-viewer-token}"
# The ruler and Grafana provisioning both poll every 60s; allow 2.5 cycles.
ACCEPT_TIMEOUT="${SKYEYE_ACCEPT_TIMEOUT:-150}"
ACCEPT_INTERVAL="${SKYEYE_ACCEPT_INTERVAL:-5}"

usage() {
  printf '%s\n' \
    'Usage: scripts/central-deploy [--dry-run | --status] [--remote NAME] [--branch NAME]' \
    '                              [--manual-applied SHA]' \
    '' \
    'Validates REMOTE/BRANCH in a temporary worktree (promtool check config,' \
    'promtool test rules, the derived Trading inventory test, every dashboard,' \
    'the Loki rules in a throwaway ruler and, when changed, amtool check-config),' \
    'then fast-forwards this checkout, hot-reloads Prometheus/Alertmanager and,' \
    'for changed rules or dashboards, waits for Loki and Grafana to load them.' \
    'Refuses dirty trees, untracked files in loaded config paths,' \
    'non-fast-forward updates and changes that need a container recreate since' \
    'HEAD or the last successful apply. Rerunning retries a reload or a load' \
    'that did not complete.' \
    '' \
    'A dashboard change needs a Grafana Viewer service account token, mode 0600' \
    'and outside the checkout, at SKYEYE_GRAFANA_TOKEN_FILE (default' \
    "$GRAFANA_TOKEN_FILE)." \
    '' \
    '--manual-applied SHA states that the recreate-only changes up to SHA were' \
    'applied by hand (docker compose up -d <service>); SHA must be the target' \
    'commit and the checkout must already be there. It is recorded as applied' \
    'only after the same validation, reloads and confirmation pass.'
}

die() {
  printf 'central-deploy: %s\n' "$*" >&2
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) MODE=dry-run; shift ;;
    --status) MODE=status; shift ;;
    --remote)
      [[ $# -ge 2 ]] || die "--remote requires a name"
      REMOTE="$2"; shift 2 ;;
    --branch)
      [[ $# -ge 2 ]] || die "--branch requires a name"
      BRANCH="$2"; shift 2 ;;
    --manual-applied)
      [[ $# -ge 2 ]] || die "--manual-applied requires the target commit applied by hand"
      [[ "$2" =~ ^[0-9a-f]{7,40}$ ]] || die "--manual-applied takes a commit hash, got: $2"
      MANUAL_APPLIED="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

[[ "$ACCEPT_TIMEOUT" =~ ^[0-9]+$ ]] || die "SKYEYE_ACCEPT_TIMEOUT must be whole seconds, got: $ACCEPT_TIMEOUT"

cd "$REPO_ROOT"

# Directories the running services load straight from this checkout, and the
# only untracked files allowed inside them (local secrets, never in Git).
LOADED_CONFIG_PATHS=(prometheus alertmanager grafana/dashboards grafana/provisioning loki/rules)
ALLOWED_LOCAL_FILES=(alertmanager/secrets/tg_token)

applied_file() {
  printf '%s/skyeye-central-deploy.applied\n' "$(git rev-parse --absolute-git-dir)"
}

# Prints the last successfully applied commit, or nothing if none is recorded.
read_applied() {
  local path recorded
  path="$(applied_file)"
  [[ -f "$path" ]] || return 0
  recorded="$(head -n 1 "$path")"
  if [[ "$recorded" =~ ^[0-9a-f]{40}$ ]] && git cat-file -e "$recorded^{commit}" 2>/dev/null; then
    printf '%s\n' "$recorded"
  fi
}

prom_query() {
  # Prints one "label=value ..." line per result sample.
  local query="$1"
  "$CURL_BIN" -fsS --get --data-urlencode "query=$query" "$PROM_URL/api/v1/query" | \
    python3 -c '
import json, sys
payload = json.load(sys.stdin)
if payload.get("status") != "success":
    sys.exit("query failed: %s" % payload.get("error"))
for sample in payload["data"]["result"]:
    labels = sample["metric"]
    keys = [k for k in ("server_id", "strategy", "quote_currency", "history_capable") if k in labels]
    fields = ["%s=%s" % (k, labels[k]) for k in keys] or ["value=%s" % sample["value"][1]]
    print(" ".join(fields))
'
}

show_status() {
  local reload_ok
  reload_ok="$(prom_query 'prometheus_config_last_reload_successful')" || \
    die "cannot query Prometheus at $PROM_URL"
  printf 'Prometheus last reload successful: %s\n' "${reload_ok#value=}"
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local applied
    applied="$(read_applied)"
    printf 'Checkout HEAD: %s; last applied by central-deploy: %s\n' \
      "$(git rev-parse --short=12 HEAD)" "${applied:0:12}"
  fi
  printf 'Live trading_target_info rows (recording rules evaluate every 1m):\n'
  prom_query 'trading_target_info' | sort | sed 's/^/  /'
}

if [[ "$MODE" == "status" ]]; then
  show_status
  exit 0
fi

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not a git checkout: $REPO_ROOT"
current_branch="$(git symbolic-ref --quiet --short HEAD || true)"
[[ "$current_branch" == "$BRANCH" ]] || \
  die "checkout is on '${current_branch:-detached HEAD}', expected $BRANCH"
[[ -z "$(git status --porcelain --untracked-files=no)" ]] || \
  die "tracked files have local changes; commit, upstream or discard them before deploying"

# The services load these directories directly, so an untracked file there
# would go live without passing the validation below.
unexpected_files=()
while IFS= read -r -d '' untracked_path; do
  allowed=0
  for allowed_path in "${ALLOWED_LOCAL_FILES[@]}"; do
    if [[ "$untracked_path" == "$allowed_path" ]]; then
      allowed=1
    fi
  done
  if [[ "$allowed" -eq 0 ]]; then
    unexpected_files+=("$untracked_path")
  fi
done < <(git ls-files -z --others -- "${LOADED_CONFIG_PATHS[@]}")
if [[ "${#unexpected_files[@]}" -gt 0 ]]; then
  printf 'Untracked files in loaded config paths (%s) would go live unvalidated:\n' \
    "${LOADED_CONFIG_PATHS[*]}" >&2
  printf '  %s\n' "${unexpected_files[@]}" >&2
  die "refusing to deploy; commit them upstream or move them out of the checkout (allowed untracked local files: ${ALLOWED_LOCAL_FILES[*]})"
fi

git fetch --quiet "$REMOTE" "$BRANCH"
head_sha="$(git rev-parse HEAD)"
target_sha="$(git rev-parse "refs/remotes/$REMOTE/$BRANCH")"
applied_sha="$(read_applied)"
manual_sha=""
if [[ -n "$MANUAL_APPLIED" ]]; then
  manual_sha="$(git rev-parse --verify --quiet "$MANUAL_APPLIED^{commit}")" || \
    die "--manual-applied: unknown commit $MANUAL_APPLIED"
  [[ "$manual_sha" == "$target_sha" ]] || \
    die "--manual-applied names ${manual_sha:0:12}, but $REMOTE/$BRANCH is ${target_sha:0:12}; name the target commit you applied by hand"
  [[ "$head_sha" == "$target_sha" ]] || \
    die "--manual-applied needs the checkout already at ${target_sha:0:12} (HEAD is ${head_sha:0:12}); apply the change by hand first"
fi
if [[ "$head_sha" == "$target_sha" && "$applied_sha" == "$target_sha" ]]; then
  printf 'Already up to date and applied at %s; nothing to deploy\n' "${head_sha:0:12}"
  exit 0
fi

prom_reload=0
am_reload=0
loki_rules=0
dashboards=0
dashboards_unrecorded=0
dashboard_paths=()
manual_paths=()
classify_path() {
  case "$1" in
    prometheus/prometheus.yml|prometheus/rules/*) prom_reload=1 ;;
    alertmanager/alertmanager.yml|alertmanager/templates/*) am_reload=1 ;;
    loki/rules/*) loki_rules=1 ;;
    grafana/dashboards/*) dashboards=1 ;;
    docs/*|runbooks/*|agents/*|tests/*|scripts/*|infra/*|*.md|.gitignore) ;;
    *) return 1 ;;
  esac
}

if [[ "$head_sha" != "$target_sha" ]]; then
  git merge-base --is-ancestor "$head_sha" "$target_sha" || \
    die "$REMOTE/$BRANCH is not a fast-forward of HEAD; resolve by hand"
  printf 'Deploying %s -> %s\n' "${head_sha:0:12}" "${target_sha:0:12}"
  git log --oneline "$head_sha..$target_sha" | sed 's/^/  /'
else
  printf 'Checkout is already at %s but central-deploy has not applied it (last applied: %s); validating and reloading\n' \
    "${head_sha:0:12}" "${applied_sha:0:12}"
fi

# A path that differs from HEAD or from the last successful apply may not be
# live yet: reload it if it can be, refuse it if it cannot. The last-apply diff
# covers a reload that failed earlier and commits pulled by hand since then.
change_bases=("$head_sha")
if [[ -n "$applied_sha" ]]; then
  change_bases+=("$applied_sha")
else
  printf 'No record of a successful central-deploy; reloading Prometheus and Alertmanager and confirming Loki and Grafana\n'
  prom_reload=1
  am_reload=1
  loki_rules=1
  dashboards=1
  dashboards_unrecorded=1
fi
for change_base in "${change_bases[@]}"; do
  [[ "$change_base" != "$target_sha" ]] || continue
  # --no-renames: a rule or dashboard moved elsewhere must count as removed.
  changed_paths="$(git diff --no-renames --name-only "$change_base" "$target_sha")" || \
    die "cannot list the changes from ${change_base:0:12} to ${target_sha:0:12}"
  while IFS= read -r changed_path; do
    [[ -n "$changed_path" ]] || continue
    classify_path "$changed_path" || manual_paths+=("$changed_path")
    if [[ "$changed_path" == grafana/dashboards/*.json ]]; then
      dashboard_paths+=("$changed_path")
    fi
  done <<<"$changed_paths"
done

if [[ "${#manual_paths[@]}" -gt 0 ]]; then
  if [[ -n "$applied_sha" ]]; then
    printf 'These paths changed since the last central-deploy apply (%s) and need a service recreate or a manual decision:\n' \
      "${applied_sha:0:12}" >&2
  else
    printf 'These paths change between HEAD (%s) and %s and need a service recreate or a manual decision:\n' \
      "${head_sha:0:12}" "${target_sha:0:12}" >&2
  fi
  printf '%s\n' "${manual_paths[@]}" | sort -u | sed 's/^/  /' >&2
  if [[ -z "$manual_sha" ]]; then
    by_hand="docker compose up -d <service> for each change above"
    [[ "$head_sha" == "$target_sha" ]] || by_hand="git merge --ff-only ${target_sha:0:12}, then $by_hand"
    die "refusing to deploy; nothing was reloaded or recorded. Apply it by hand from this checkout ($by_hand), then record it with: scripts/central-deploy --manual-applied ${target_sha:0:12}"
  fi
  printf 'Treating them as applied by hand at %s (--manual-applied)\n' "${target_sha:0:12}"
fi

WORK_DIR="$(mktemp -d "${TMPDIR:-/tmp}/skyeye-central-deploy.XXXXXX")"
TREE="$WORK_DIR/tree"
cleanup() {
  local status=$?
  git worktree remove --force "$TREE" >/dev/null 2>&1 || true
  rm -rf "$WORK_DIR"
  exit "$status"
}
trap cleanup EXIT
git worktree add --quiet --detach "$TREE" "$target_sha"

compose_image() {
  awk -v want="$1" '$1 == "image:" && index($2, want ":") == 1 { print $2; exit }' \
    "$TREE/docker-compose.yml"
}

# Dashboard validation and the read-only checks against Loki and Grafana. It
# reads the token file itself and hands it to curl on stdin, so the token never
# reaches a process argument or this script's output.
IFS= read -r -d '' HELPER_PY <<'PY' || true
import json
import os
import re
import subprocess
import sys

LOKI_GROUP_FIELDS = ("file", "name", "interval")
LOKI_RULE_FIELDS = ("name", "query", "duration", "labels", "annotations")


def refuse_constant(value):
    raise ValueError("%s is not valid JSON" % value)


def load_dashboard(path):
    with open(path, encoding="utf-8") as handle:
        dashboard = json.loads(handle.read(), parse_constant=refuse_constant)
    if not isinstance(dashboard, dict):
        raise ValueError("top level must be a single JSON object")
    for field in ("uid", "title"):
        value = dashboard.get(field)
        if not isinstance(value, str) or not value.strip():
            raise ValueError("needs a non-empty %s" % field)
    return dashboard


def comparable(dashboard):
    return {key: value for key, value in dashboard.items() if key not in ("id", "version")}


def old_uid(bases, path):
    for base in bases:
        shown = subprocess.run(["git", "show", "%s:%s" % (base, path)], capture_output=True)
        if shown.returncode != 0:
            continue
        try:
            old = json.loads(shown.stdout)
        except ValueError:
            continue
        if isinstance(old, dict) and old.get("uid"):
            return old["uid"]
    return None


def dashboards_validate(root, output, unrecorded, rest):
    # Grafana drops a file with a clashing title silently, and a clashing uid
    # stops the whole provider from writing, so both are refused up front.
    split = rest.index("--")
    bases, changed = rest[:split], rest[split + 1:]
    dashboards, uids, titles, errors = {}, {}, {}, []
    for directory, _, names in os.walk(root):
        for name in sorted(names):
            if not name.endswith(".json"):
                continue
            path = os.path.join(directory, name)
            relative = os.path.relpath(path, root)
            try:
                dashboard = load_dashboard(path)
            except (ValueError, OSError) as error:
                errors.append("%s: %s" % (relative, error))
                continue
            dashboards[relative] = dashboard
            title = (os.path.basename(directory), dashboard["title"])
            for seen, key, label in ((uids, dashboard["uid"], "uid"), (titles, title, "title")):
                if key in seen:
                    errors.append("%s: same %s as %s" % (relative, label, seen[key]))
                seen.setdefault(key, relative)
    if errors:
        sys.exit("\n".join("invalid dashboard " + error for error in errors))

    expected, absent = {}, set()
    for path in changed:
        relative = os.path.relpath(path, "grafana/dashboards")
        if relative in dashboards:
            dashboard = dashboards[relative]
            expected[dashboard["uid"]] = {"path": relative, "body": comparable(dashboard)}
        else:
            uid = old_uid(bases, path)
            if uid and uid not in uids:
                absent.add(uid)
    manifest = {
        "changed": expected,
        "absent": sorted(absent),
        # Without a record there is no baseline to tell a load that never
        # happened from a UI edit, so only presence can be required.
        "present": sorted(uids) if unrecorded == "1" else [],
    }
    with open(output, "w", encoding="utf-8") as handle:
        json.dump(manifest, handle)


def token_header(path, checkout):
    real, root = os.path.realpath(path), os.path.realpath(checkout)
    if real == root or real.startswith(root + os.sep):
        sys.exit("Grafana token file %s must be outside the checkout" % path)
    try:
        mode = os.stat(path).st_mode
        with open(path, encoding="ascii") as handle:
            token = handle.read().strip()
    except OSError as error:
        sys.exit("cannot read Grafana token file %s: %s" % (path, error.strerror))
    except UnicodeError:
        sys.exit("Grafana token file %s is not a Grafana token" % path)
    if mode & 0o077:
        sys.exit("Grafana token file %s must be mode 0600, not %04o" % (path, mode & 0o777))
    if not re.fullmatch(r"[A-Za-z0-9_-]+", token):
        sys.exit("Grafana token file %s is not a Grafana token" % path)
    return 'header = "Authorization: Bearer %s"\n' % token


def grafana_get(curl, url, header, path):
    done = subprocess.run(
        [curl, "--config", "-", "-fsS", "--max-time", "10", url + path],
        input=header, capture_output=True, text=True,
    )
    if done.returncode != 0:
        sys.exit("GET %s failed: %s" % (path, done.stderr.strip() or "curl exit %d" % done.returncode))
    try:
        return json.loads(done.stdout)
    except ValueError:
        sys.exit("GET %s did not return JSON" % path)


def grafana_probe(curl, url, token_file, checkout):
    # A token without a role is answered with 200 and an empty list.
    header = token_header(token_file, checkout)
    if not grafana_get(curl, url, header, "/api/search?type=dash-db&limit=1"):
        sys.exit("the Grafana token sees no dashboards; it needs the Viewer role")


def grafana_confirm(curl, url, token_file, checkout, manifest_path):
    with open(manifest_path, encoding="utf-8") as handle:
        manifest = json.load(handle)
    header = token_header(token_file, checkout)
    served = {item["uid"] for item in grafana_get(curl, url, header, "/api/search?type=dash-db&limit=5000")}
    problems = ["%s is not provisioned" % uid for uid in manifest["present"] if uid not in served]
    problems += ["%s was removed but is still served" % uid for uid in manifest["absent"] if uid in served]
    for uid, want in sorted(manifest["changed"].items()):
        if uid not in served:
            problems.append("%s (%s) is not provisioned" % (uid, want["path"]))
            continue
        live = grafana_get(curl, url, header, "/api/dashboards/uid/" + uid)
        if comparable(live.get("dashboard", {})) != want["body"]:
            problems.append("%s still serves other content than %s" % (uid, want["path"]))
        elif live.get("meta", {}).get("provisionedExternalId") != want["path"]:
            problems.append("%s is not provisioned from %s" % (uid, want["path"]))
    if problems:
        sys.exit(", ".join(problems))
    print("%d changed, %d removed, %d present" % (len(manifest["changed"]), len(manifest["absent"]), len(manifest["present"])))


def loki_groups(path):
    with open(path, encoding="utf-8") as handle:
        groups = json.load(handle)["data"]["groups"]
    return {
        (group["file"], group["name"]): (
            [group.get(field) for field in LOKI_GROUP_FIELDS],
            [[rule.get(field) for field in LOKI_RULE_FIELDS] for rule in group["rules"]],
        )
        for group in groups
    }


def loki_compare(expected_path, live_path):
    try:
        live = loki_groups(live_path)
    except (ValueError, KeyError, TypeError):
        sys.exit("the ruler did not return a rule list")
    expected = loki_groups(expected_path)
    differing = sorted(
        "%s/%s" % key for key in set(expected) | set(live) if expected.get(key) != live.get(key)
    )
    if differing:
        sys.exit("loaded rules differ from the target in " + ", ".join(differing))
    print(len(expected))


mode, arguments = sys.argv[1], sys.argv[2:]
if mode == "dashboards-validate":
    dashboards_validate(arguments[0], arguments[1], arguments[2], arguments[3:])
elif mode == "grafana-probe":
    grafana_probe(*arguments)
elif mode == "grafana-confirm":
    grafana_confirm(*arguments)
elif mode == "loki-compare":
    loki_compare(*arguments)
else:
    sys.exit("unknown helper mode: %s" % mode)
PY

helper() {
  python3 -I -c "$HELPER_PY" "$@"
}

# Runs inside the pinned Loki image with no network. The ruler's own loader is
# the check: an invalid file fails the rule API, and that same loader is what
# the live ruler will use. Prints the rules as loaded, which is the normalized
# form the live ruler must report later. Only the ruler section of
# loki/loki-config.yml matters here; storage is a throwaway local path.
IFS= read -r -d '' LOKI_CHECK_SH <<'SH' || true
cat >/tmp/loki-check.yaml <<'YAML'
auth_enabled: false
server:
  http_listen_address: 127.0.0.1
  http_listen_port: 3100
  grpc_listen_address: 127.0.0.1
  grpc_listen_port: 9096
  log_level: warn
common:
  path_prefix: /tmp/loki
  replication_factor: 1
  ring:
    instance_addr: 127.0.0.1
    kvstore:
      store: inmemory
  storage:
    filesystem:
      chunks_directory: /tmp/loki/chunks
      rules_directory: /tmp/loki/unused
schema_config:
  configs:
    - from: 2026-04-22
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h
ruler:
  storage:
    type: local
    local:
      directory: /loki/rules
  rule_path: /tmp/loki/rules-temp
  enable_api: true
analytics:
  reporting_enabled: false
YAML
/usr/bin/loki -config.file=/tmp/loki-check.yaml -target=ruler >/tmp/loki-check.log 2>&1 &
pid=$!
fail() {
  printf 'Loki ruler check: %s\n' "$1" >&2
  grep -E 'level=(error|warn)' /tmp/loki-check.log | tail -n 5 | cut -c1-600 >&2
  kill "$pid" 2>/dev/null
  exit 1
}
tries=0
until wget -q -T 2 -O /dev/null http://127.0.0.1:3100/ready 2>/dev/null; do
  kill -0 "$pid" 2>/dev/null || fail 'Loki exited during startup'
  tries=$((tries + 1))
  [ "$tries" -lt 120 ] || fail 'Loki did not become ready'
  sleep 0.25
done
wget -q -O /dev/null http://127.0.0.1:3100/loki/api/v1/rules 2>/dev/null || \
  fail 'the ruler rejected the rule files'
tries=0
until wget -q -O /tmp/loki-check.json http://127.0.0.1:3100/prometheus/api/v1/rules 2>/dev/null &&
  grep -q '"groups":\[{' /tmp/loki-check.json; do
  tries=$((tries + 1))
  [ "$tries" -lt 40 ] || fail 'the ruler did not load the rule files'
  sleep 0.25
done
cat /tmp/loki-check.json
kill "$pid" 2>/dev/null
exit 0
SH

validate_dashboards() {
  printf 'Validating dashboards in %s\n' "${target_sha:0:12}"
  helper dashboards-validate "$TREE/grafana/dashboards" "$WORK_DIR/grafana-expected.json" \
    "$dashboards_unrecorded" "${change_bases[@]}" -- \
    ${dashboard_paths[@]+"${dashboard_paths[@]}"} || \
    die "dashboards in ${target_sha:0:12} are invalid; nothing moved"
}

validate_loki_rules() {
  local rules_dir="$TREE/loki/rules" stray image
  printf '{"status":"success","data":{"groups":[]}}\n' >"$WORK_DIR/loki-expected.json"
  [[ -d "$rules_dir" ]] || return 0
  # auth_enabled=false reads tenant "fake" only. The ruler skips subdirectories
  # without a word, and a bad file in another tenant blanks every rule.
  stray="$(cd "$rules_dir" && find . -mindepth 1 ! -path ./fake \
    ! \( -type f -path './fake/*' ! -path './fake/*/*' \))"
  [[ -z "$stray" ]] || die "loki/rules may only hold files directly in fake/; found: ${stray//$'\n'/ }"
  [[ -n "$(find "$rules_dir/fake" -type f -print -quit 2>/dev/null)" ]] || return 0
  image="$(compose_image grafana/loki)"
  [[ -n "$image" ]] || die "cannot find the pinned Loki image in docker-compose.yml"
  printf 'Validating Loki rules with %s\n' "$image"
  # --pull=never: this must not download anything onto the host.
  "$DOCKER_BIN" run --rm --pull=never --network none -v "$rules_dir:/loki/rules:ro" \
    --entrypoint /bin/sh "$image" -c "$LOKI_CHECK_SH" >"$WORK_DIR/loki-expected.json" || \
    die "Loki rules in ${target_sha:0:12} were rejected or could not be checked; nothing moved. If the target commit changed the Loki tag, pull it first: docker pull $image"
}

check_grafana_token() {
  helper grafana-probe "$CURL_BIN" "$GRAFANA_URL" "$GRAFANA_TOKEN_FILE" "$REPO_ROOT" || \
    die "dashboards changed, but Grafana cannot be read back with the token in $GRAFANA_TOKEN_FILE; nothing moved"
}

# Prints why the ruler has not loaded the target rules, if it has not.
loki_accepted() {
  local live="$WORK_DIR/loki-live.json"
  if ! "$CURL_BIN" -fsS --max-time 10 "$LOKI_URL/prometheus/api/v1/rules" >"$live" 2>&1; then
    printf 'cannot read the loaded rules: %s\n' "$(tail -n 1 "$live")"
    return 1
  fi
  helper loki-compare "$WORK_DIR/loki-expected.json" "$live" 2>&1
}

# The ruler keeps its old rules on a bad file; only this view gives the reason.
loki_store_error() {
  if ! "$CURL_BIN" -fsS --max-time 10 "$LOKI_URL/loki/api/v1/rules" >/dev/null 2>&1; then
    "$CURL_BIN" -sS --max-time 10 "$LOKI_URL/loki/api/v1/rules" 2>&1 | head -c 500 || true
  fi
}

confirm_services() {
  local deadline=$((SECONDS + ACCEPT_TIMEOUT)) result store_error
  local loki_pending="$loki_rules" grafana_pending="$dashboards"
  local loki_reason="" grafana_reason="" reasons=""
  if [[ "$loki_pending" -eq 1 || "$grafana_pending" -eq 1 ]]; then
    printf 'Published %s; waiting up to %ss for Loki=%s Grafana=%s to load it\n' \
      "${target_sha:0:12}" "$ACCEPT_TIMEOUT" "$loki_pending" "$grafana_pending"
  fi
  while [[ "$loki_pending" -eq 1 || "$grafana_pending" -eq 1 ]]; do
    if [[ "$loki_pending" -eq 1 ]]; then
      if result="$(loki_accepted)"; then
        printf 'Loki ruler loaded %s: %s rule groups\n' "${target_sha:0:12}" "$result"
        loki_pending=0
      else
        loki_reason="$result"
      fi
    fi
    if [[ "$grafana_pending" -eq 1 ]]; then
      if result="$(helper grafana-confirm "$CURL_BIN" "$GRAFANA_URL" "$GRAFANA_TOKEN_FILE" \
        "$REPO_ROOT" "$WORK_DIR/grafana-expected.json" 2>&1)"; then
        printf 'Grafana loaded %s: %s\n' "${target_sha:0:12}" "$result"
        grafana_pending=0
      else
        grafana_reason="$result"
      fi
    fi
    [[ "$loki_pending" -eq 1 || "$grafana_pending" -eq 1 ]] || return 0
    [[ "$SECONDS" -lt "$deadline" ]] || break
    sleep "$ACCEPT_INTERVAL"
  done
  if [[ "$loki_pending" -eq 1 ]]; then
    store_error="$(loki_store_error)"
    reasons="Loki ruler: $loki_reason${store_error:+ (rule API: $store_error)}. "
  fi
  if [[ "$grafana_pending" -eq 1 ]]; then
    reasons="${reasons}Grafana: $grafana_reason. "
  fi
  if [[ -n "$reasons" ]]; then
    die "${target_sha:0:12} is published but not loaded after ${ACCEPT_TIMEOUT}s, so it is not recorded as applied and the checkout stays there. $reasons$rollback_hint"
  fi
}

prom_image="$(compose_image prom/prometheus)"
am_image="$(compose_image prom/alertmanager)"
[[ -n "$prom_image" ]] || die "cannot find the pinned Prometheus image in docker-compose.yml"

printf 'Validating %s with %s\n' "${target_sha:0:12}" "$prom_image"
"$DOCKER_BIN" run --rm -v "$TREE/prometheus:/etc/prometheus:ro" --entrypoint /bin/promtool \
  "$prom_image" check config /etc/prometheus/prometheus.yml
rule_tests=()
while IFS= read -r rule_test; do
  rule_tests+=("/etc/prometheus/rules/tests/$(basename "$rule_test")")
done < <(find "$TREE/prometheus/rules/tests" -maxdepth 1 -type f -name '*.yml' | sort)
if [[ "${#rule_tests[@]}" -gt 0 ]]; then
  "$DOCKER_BIN" run --rm -v "$TREE/prometheus:/etc/prometheus:ro" --entrypoint /bin/promtool \
    "$prom_image" test rules "${rule_tests[@]}"
fi
if [[ -x "$TREE/scripts/trading-target" ]]; then
  "$TREE/scripts/trading-target" --file "$TREE/prometheus/rules/trading-targets.yml" check >/dev/null
  "$TREE/scripts/trading-target" --file "$TREE/prometheus/rules/trading-targets.yml" render-test \
    --rule-file /etc/prometheus/rules/trading-targets.yml \
    --rule-file /etc/prometheus/rules/trading.yml \
    --output "$WORK_DIR/trading-derived.test.yml"
  "$DOCKER_BIN" run --rm -v "$TREE/prometheus:/etc/prometheus:ro" \
    -v "$WORK_DIR/trading-derived.test.yml:/tmp/trading-derived.test.yml:ro" \
    --entrypoint /bin/promtool "$prom_image" test rules /tmp/trading-derived.test.yml
fi
if [[ "$am_reload" -eq 1 ]]; then
  [[ -n "$am_image" ]] || die "cannot find the pinned Alertmanager image in docker-compose.yml"
  "$DOCKER_BIN" run --rm -v "$TREE/alertmanager:/etc/alertmanager:ro" --entrypoint /bin/amtool \
    "$am_image" check-config /etc/alertmanager/alertmanager.yml
fi
validate_dashboards
validate_loki_rules
if [[ "$dashboards" -eq 1 ]]; then
  check_grafana_token
fi

if [[ "$MODE" == "dry-run" ]]; then
  printf 'Dry run: validation passed; checkout left at %s and nothing reloaded (would reload: Prometheus=%s Alertmanager=%s; would confirm: Loki=%s Grafana=%s)\n' \
    "${head_sha:0:12}" "$prom_reload" "$am_reload" "$loki_rules" "$dashboards"
  exit 0
fi

if [[ "$head_sha" != "$target_sha" ]]; then
  git merge --ff-only --quiet "$target_sha"
  printf 'Checkout fast-forwarded to %s (previous %s)\n' "${target_sha:0:12}" "${head_sha:0:12}"
fi

undo_sha="${applied_sha:-$head_sha}"
rollback_hint="rerun scripts/central-deploy after fixing the cause to retry; to return to the previous config instead: git reset --hard $undo_sha && curl -fsS -X POST $PROM_URL/-/reload"
if [[ "$prom_reload" -eq 1 ]]; then
  "$CURL_BIN" -fsS -X POST "$PROM_URL/-/reload" >/dev/null || \
    die "Prometheus rejected the reload; $rollback_hint"
  printf 'Prometheus reloaded\n'
fi
if [[ "$am_reload" -eq 1 ]]; then
  "$CURL_BIN" -fsS -X POST "$AM_URL/-/reload" >/dev/null || \
    die "Alertmanager rejected the reload; $rollback_hint"
  printf 'Alertmanager reloaded\n'
fi

if [[ "$prom_reload" -eq 1 ]]; then
  show_status
  [[ "$(prom_query 'prometheus_config_last_reload_successful')" == "value=1" ]] || \
    die "Prometheus reports an unsuccessful config reload; $rollback_hint"
fi
confirm_services
applied_path="$(applied_file)"
printf '%s\n' "$target_sha" >"$applied_path.tmp"
mv "$applied_path.tmp" "$applied_path"
printf 'central-deploy: done; applied %s\n' "${target_sha:0:12}"
