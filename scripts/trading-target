#!/usr/bin/env python3
"""Deterministically manage the central Trading target inventory.

The inventory (prometheus/rules/trading-targets.yml) is the single source of
truth that Prometheus loads. This tool owns its format: it parses the file
strictly, refuses anything it does not recognise, and re-renders it
canonically so additions and removals are one-hunk, reviewable diffs.

Subcommands:
  add          append one shadow-only trading_target_info row (idempotent)
  remove       delete one row and its legacy alias (idempotent)
  list         print rows as TSV or JSON
  check        verify the file is canonical and internally consistent
  render-test  emit a promtool test derived from the inventory

Standard library only; no third-party packages.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
import tempfile
from dataclasses import dataclass, field
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
DEFAULT_INVENTORY = REPO_ROOT / "prometheus" / "rules" / "trading-targets.yml"

GROUP_HEADER = [
    "groups:",
    "  - name: trading-target-inventory",
    "    interval: 1m",
    "    rules:",
]
RECORD_RE = re.compile(r"^      - record: (\S+)$")
EXPR_LINE = "        expr: vector(1)"
LABELS_LINE = "        labels:"
LABEL_RE = re.compile(r"^          ([a-z_]+): (.+)$")

PRIMARY_RECORD = "trading_target_info"
LEGACY_RECORD = "tnauqquant_target_info"
ALLOWED_RECORDS = (PRIMARY_RECORD, LEGACY_RECORD)

LABEL_ORDER = (
    "product",
    "environment",
    "server_id",
    "strategy",
    "notification_mode",
    "quote_currency",
    "history_capable",
)
REQUIRED_LABELS = LABEL_ORDER[:-1]

# Same identity rule as agents/alloy/trading/setup-linux.sh valid_label_value.
IDENTITY_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$")
QUOTE_RE = re.compile(r"^[A-Z][A-Z0-9]{1,9}$")
ENVIRONMENTS = ("production",)
NOTIFICATION_MODES = ("shadow",)

YAML_NON_STRING_RE = re.compile(
    r"^(?:(?i:true|false|yes|no|on|off|y|n|null)|~"
    r"|[-+]?(?:[0-9][0-9_]*)?(?:\.[0-9_]*)?(?:[eE][-+]?[0-9]+)?"
    r"|0[xXoObB][0-9A-Fa-f_]+)$"
)


class InventoryError(Exception):
    pass


@dataclass
class Row:
    record: str
    labels: dict[str, str] = field(default_factory=dict)

    @property
    def identity(self) -> tuple[str, str]:
        return (self.labels["server_id"], self.labels["strategy"])

    @property
    def history_capable(self) -> bool:
        return self.labels.get("history_capable") == "true"


@dataclass
class Inventory:
    comments: list[str]
    rows: list[Row]

    def primary_rows(self) -> list[Row]:
        return [row for row in self.rows if row.record == PRIMARY_RECORD]


def needs_quote(value: str) -> bool:
    return value == "" or bool(YAML_NON_STRING_RE.match(value))


def render_value(value: str) -> str:
    return f'"{value}"' if needs_quote(value) else value


def parse_value(raw: str, where: str) -> str:
    if raw.startswith('"') or raw.endswith('"'):
        if len(raw) < 2 or not (raw.startswith('"') and raw.endswith('"')):
            raise InventoryError(f"{where}: unbalanced quotes in {raw!r}")
        inner = raw[1:-1]
        if '"' in inner or "\\" in inner:
            raise InventoryError(f"{where}: unsupported escape in {raw!r}")
        return inner
    if raw.startswith("'") or any(c in raw for c in "#:{}[],&*!|>%@`"):
        raise InventoryError(f"{where}: unsupported YAML scalar {raw!r}")
    return raw


def validate_row(row: Row, where: str) -> None:
    if row.record not in ALLOWED_RECORDS:
        raise InventoryError(f"{where}: unsupported record {row.record!r}")
    keys = list(row.labels)
    for key in keys:
        if key not in LABEL_ORDER:
            raise InventoryError(f"{where}: unsupported label {key!r}")
    for key in REQUIRED_LABELS:
        if key not in row.labels:
            raise InventoryError(f"{where}: missing label {key!r}")
    labels = row.labels
    for key in ("product", "server_id", "strategy"):
        if not IDENTITY_RE.match(labels[key]):
            raise InventoryError(f"{where}: invalid {key} {labels[key]!r}")
    if labels["environment"] not in ENVIRONMENTS:
        raise InventoryError(
            f"{where}: environment must be one of {ENVIRONMENTS}, got {labels['environment']!r}"
        )
    if labels["notification_mode"] not in NOTIFICATION_MODES:
        raise InventoryError(
            f"{where}: notification_mode must be shadow; paging needs a separate canary change"
        )
    if not QUOTE_RE.match(labels["quote_currency"]):
        raise InventoryError(f"{where}: invalid quote_currency {labels['quote_currency']!r}")
    if "history_capable" in labels and labels["history_capable"] != "true":
        raise InventoryError(f"{where}: history_capable may only be \"true\" (omit for false)")


def parse_inventory(text: str, path: str) -> Inventory:
    lines = text.split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    else:
        raise InventoryError(f"{path}: file must end with exactly one newline")
    index = 0
    comments: list[str] = []
    while index < len(lines) and lines[index].startswith("#"):
        comments.append(lines[index])
        index += 1
    if comments:
        if index >= len(lines) or lines[index] != "":
            raise InventoryError(f"{path}: header comments must be followed by one blank line")
        index += 1
    if lines[index : index + len(GROUP_HEADER)] != GROUP_HEADER:
        raise InventoryError(f"{path}:{index + 1}: unexpected group header")
    index += len(GROUP_HEADER)

    rows: list[Row] = []
    while index < len(lines):
        if rows:
            if lines[index] != "":
                raise InventoryError(f"{path}:{index + 1}: rows must be separated by one blank line")
            index += 1
        where = f"{path}:{index + 1}"
        match = RECORD_RE.match(lines[index]) if index < len(lines) else None
        if not match:
            raise InventoryError(f"{where}: expected '      - record: NAME'")
        row = Row(record=match.group(1))
        if lines[index + 1 : index + 3] != [EXPR_LINE, LABELS_LINE]:
            raise InventoryError(f"{where}: expected 'expr: vector(1)' then 'labels:'")
        index += 3
        while index < len(lines) and lines[index] != "":
            label_match = LABEL_RE.match(lines[index])
            if not label_match:
                raise InventoryError(f"{path}:{index + 1}: unsupported line {lines[index]!r}")
            key, raw = label_match.groups()
            if key in row.labels:
                raise InventoryError(f"{path}:{index + 1}: duplicate label {key!r}")
            row.labels[key] = parse_value(raw, f"{path}:{index + 1}")
            index += 1
        validate_row(row, where)
        rows.append(row)

    inventory = Inventory(comments=comments, rows=rows)
    validate_inventory(inventory, path)
    return inventory


def validate_inventory(inventory: Inventory, path: str) -> None:
    seen: set[tuple[str, str, str]] = set()
    for row in inventory.rows:
        key = (row.record, *row.identity)
        if key in seen:
            raise InventoryError(
                f"{path}: duplicate {row.record} row for server_id={row.identity[0]} strategy={row.identity[1]}"
            )
        seen.add(key)
    primary = {row.identity for row in inventory.primary_rows()}
    for row in inventory.rows:
        if row.record == LEGACY_RECORD and row.identity not in primary:
            raise InventoryError(
                f"{path}: legacy {LEGACY_RECORD} row {row.identity} has no {PRIMARY_RECORD} row"
            )


def render_inventory(inventory: Inventory) -> str:
    out: list[str] = []
    if inventory.comments:
        out.extend(inventory.comments)
        out.append("")
    out.extend(GROUP_HEADER)
    for position, row in enumerate(inventory.rows):
        if position:
            out.append("")
        out.append(f"      - record: {row.record}")
        out.append(EXPR_LINE)
        out.append(LABELS_LINE)
        for key in LABEL_ORDER:
            if key in row.labels:
                out.append(f"          {key}: {render_value(row.labels[key])}")
    return "\n".join(out) + "\n"


def load(path: Path) -> tuple[Inventory, str]:
    try:
        text = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        raise InventoryError(f"inventory not found: {path}") from None
    return parse_inventory(text, str(path)), text


def write_atomic(path: Path, text: str) -> None:
    mode = path.stat().st_mode & 0o777
    handle, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    try:
        with os.fdopen(handle, "w", encoding="utf-8") as stream:
            stream.write(text)
        os.chmod(temp_name, mode)
        os.replace(temp_name, path)
    except BaseException:
        if os.path.exists(temp_name):
            os.unlink(temp_name)
        raise


def describe(row: Row) -> str:
    extras = f" quote={row.labels['quote_currency']}"
    if row.history_capable:
        extras += " history_capable=true"
    return f"{row.record} server_id={row.identity[0]} strategy={row.identity[1]}{extras}"


def cmd_add(args: argparse.Namespace) -> int:
    path = Path(args.file)
    inventory, original = load(path)
    labels = {
        "product": args.product,
        "environment": args.environment,
        "server_id": args.server,
        "strategy": args.strategy,
        "notification_mode": "shadow",
        "quote_currency": args.quote,
    }
    if args.history:
        labels["history_capable"] = "true"
    new_row = Row(record=PRIMARY_RECORD, labels=labels)
    validate_row(new_row, "add")
    for row in inventory.primary_rows():
        if row.identity == new_row.identity:
            if row.labels == new_row.labels:
                print(f"already present: {describe(row)}")
                return 0
            raise InventoryError(
                f"server_id={args.server} strategy={args.strategy} already exists with different "
                f"labels ({describe(row)}); remove it first if the change is intended"
            )
    inventory.rows.append(new_row)
    validate_inventory(inventory, str(path))
    rendered = render_inventory(inventory)
    if args.dry_run:
        sys.stdout.write(rendered)
        return 0
    if rendered != original:
        write_atomic(path, rendered)
    print(f"added: {describe(new_row)}")
    return 0


def cmd_remove(args: argparse.Namespace) -> int:
    path = Path(args.file)
    inventory, original = load(path)
    identity = (args.server, args.strategy)
    removed = [row for row in inventory.rows if row.identity == identity]
    if not removed:
        print(f"not present: server_id={args.server} strategy={args.strategy}")
        return 0
    inventory.rows = [row for row in inventory.rows if row.identity != identity]
    rendered = render_inventory(inventory)
    if args.dry_run:
        sys.stdout.write(rendered)
        return 0
    if rendered != original:
        write_atomic(path, rendered)
    for row in removed:
        print(f"removed: {describe(row)}")
    return 0


def cmd_list(args: argparse.Namespace) -> int:
    inventory, _ = load(Path(args.file))
    rows = inventory.rows if args.all_records else inventory.primary_rows()
    if args.format == "json":
        json.dump([{"record": row.record, **row.labels} for row in rows], sys.stdout, indent=2)
        sys.stdout.write("\n")
        return 0
    for row in rows:
        fields = [row.labels["server_id"], row.labels["strategy"], row.labels["quote_currency"],
                  "true" if row.history_capable else "false"]
        if args.all_records:
            fields.insert(0, row.record)
        print("\t".join(fields))
    return 0


def cmd_check(args: argparse.Namespace) -> int:
    status = 0
    for name in args.files or [args.file]:
        path = Path(name)
        inventory, original = load(path)
        rendered = render_inventory(inventory)
        if rendered != original:
            print(f"FAIL: {path} is not in canonical scripts/trading-target form", file=sys.stderr)
            status = 1
            continue
        print(f"OK: {path} ({len(inventory.primary_rows())} {PRIMARY_RECORD} rows)")
    return status


def labels_selector(labels: dict[str, str]) -> str:
    inner = ",".join(f'{key}="{value}"' for key, value in labels.items())
    return "{" + inner + "}"


def quote_yaml(value: str) -> str:
    return "'" + value.replace("'", "''") + "'"


def cmd_render_test(args: argparse.Namespace) -> int:
    inventory_path = Path(args.file)
    inventory, _ = load(inventory_path)
    rule_files = args.rule_file or [
        str(inventory_path.resolve()),
        str((inventory_path.resolve().parent / "trading.yml")),
    ]
    rows = inventory.primary_rows()
    history_rows = [row for row in rows if row.history_capable]

    out = ["# Generated by scripts/trading-target render-test; do not edit.", "rule_files:"]
    out.extend(f"  - {quote_yaml(rule_file)}" for rule_file in rule_files)
    out += ["", "evaluation_interval: 30s", "", "tests:"]

    def samples(expr: str, eval_time: str, expected: list[tuple[str, int]]) -> None:
        out.append(f"      - expr: {quote_yaml(expr)}")
        out.append(f"        eval_time: {eval_time}")
        if not expected:
            out.append("        exp_samples: []")
            return
        out.append("        exp_samples:")
        for labels, value in expected:
            out.append(f"          - labels: {quote_yaml(labels)}")
            out.append(f"            value: {value}")

    out += [
        "  - name: inventory rows load exactly as declared",
        "    interval: 30s",
        "    promql_expr_test:",
    ]
    samples(
        PRIMARY_RECORD,
        "1m",
        [(PRIMARY_RECORD + labels_selector(
            {key: row.labels[key] for key in LABEL_ORDER if key in row.labels}), 1) for row in rows],
    )
    samples(f"count({PRIMARY_RECORD})", "1m", [("{}", len(rows))] if rows else [])

    def per_target(alertname: str, eval_time: str, expected_rows: list[Row]) -> None:
        samples(
            f'count by (server_id, strategy) (ALERTS{{alertname="{alertname}",alertstate="firing"}})',
            eval_time,
            [(labels_selector({"server_id": row.identity[0], "strategy": row.identity[1]}), 1)
             for row in expected_rows],
        )

    out += [
        "",
        "  - name: every inventoried target alerts in shadow when its telemetry is absent",
        "    interval: 30s",
        "    promql_expr_test:",
    ]
    per_target("TradingTelemetryMissing", "4m", rows)
    per_target("TradingPnlHistoryUnavailable", "4m", history_rows)
    samples(
        'count(ALERTS{alertname=~"TradingTelemetryMissing|TradingPnlHistoryUnavailable",'
        'alertstate="firing",notification_mode!="shadow"})',
        "4m",
        [],
    )

    text = "\n".join(out) + "\n"
    if args.output:
        Path(args.output).write_text(text, encoding="utf-8")
    else:
        sys.stdout.write(text)
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="scripts/trading-target",
        description="Manage the central Trading target inventory deterministically.",
    )
    parser.add_argument("--file", default=str(DEFAULT_INVENTORY),
                        help="inventory path (default: prometheus/rules/trading-targets.yml)")
    sub = parser.add_subparsers(dest="command", required=True)

    def identity(command: argparse.ArgumentParser) -> None:
        command.add_argument("--server", required=True, help="server_id label, e.g. trading01")
        command.add_argument("--strategy", required=True, help="strategy label")
        command.add_argument("--dry-run", action="store_true",
                             help="print the resulting inventory instead of writing it")

    add = sub.add_parser("add", help="add one shadow-only target row")
    identity(add)
    add.add_argument("--quote", default="USDT", help="quote_currency label (default USDT)")
    add.add_argument("--history", action="store_true",
                     help="declare history_capable=\"true\" (target runs the P&L history builder)")
    add.add_argument("--product", default="tnauqquant", help=argparse.SUPPRESS)
    add.add_argument("--environment", default="production", help=argparse.SUPPRESS)
    add.set_defaults(handler=cmd_add)

    remove = sub.add_parser("remove", help="remove one target row (and its legacy alias)")
    identity(remove)
    remove.set_defaults(handler=cmd_remove)

    listing = sub.add_parser("list", help="list inventory rows")
    listing.add_argument("--format", choices=("tsv", "json"), default="tsv")
    listing.add_argument("--all-records", action="store_true",
                         help=f"include legacy {LEGACY_RECORD} rows")
    listing.set_defaults(handler=cmd_list)

    check = sub.add_parser("check", help="verify inventory files are canonical")
    check.add_argument("files", nargs="*", metavar="FILE", help="files to check (default: --file)")
    check.set_defaults(handler=cmd_check)

    render = sub.add_parser("render-test", help="emit a promtool test derived from the inventory")
    render.add_argument("--rule-file", action="append",
                        help="rule_files entry for the test (repeatable; default: inventory + sibling trading.yml)")
    render.add_argument("--output", help="write to this path instead of stdout")
    render.set_defaults(handler=cmd_render_test)
    return parser


def main(argv: list[str]) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return args.handler(args)
    except InventoryError as error:
        print(f"trading-target: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
