#!/usr/bin/env bash
set -euo pipefail

# Add, remove, or list accounts (executors) in an already-installed Linux
# Trading monitoring strategy without any repo PR or central-deploy.
#
# Scope: Linux Trading lanes installed via agents/alloy/trading/setup-linux.sh
# only (/etc/skyeye-trading/instances/<strategy>.env). macOS (Mac mini) and
# Windows lanes are out of scope.
#
# Runs host-side agents/alloy/trading/setup-linux.sh account over SSH (default),
# against an existing host checkout (--remote-dir), or directly on the local
# host (--local).

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
LOCAL_SETUP="$REPO_ROOT/agents/alloy/trading/setup-linux.sh"
SSH_BIN="${SKYEYE_SSH_BIN:-ssh}"

SUBCOMMAND=""
SERVER_ID=""
STRATEGY=""
EXECUTOR=""
EXCHANGE=""
DRY_RUN=0
LOCAL_MODE=0
SSH_TARGET="${SKYEYE_SSH_TARGET:-}"
REMOTE_DIR="${SKYEYE_TRADING_REMOTE_DIR:-}"

# Explicit allowlist of tracked files streamed in default remote mode so no
# untracked file or local secret can ever be sent to a host.
PAYLOAD_FILES=(
  "agents/alloy/alloy-versions.env"
  "agents/alloy/install-common.sh"
  "agents/alloy/trading/account-linux.sh"
  "agents/alloy/trading/setup-linux.sh"
  "agents/alloy/trading/linux-common.sh"
  "agents/alloy/trading/probe.sh"
  "agents/alloy/trading/ensure-log-access.sh"
  "agents/alloy/trading/config-linux.alloy.tmpl"
  "agents/alloy/trading/config-linux-metrics.alloy.tmpl"
  "agents/alloy/trading/skyeye-trading-probe@.service.tmpl"
  "agents/alloy/trading/skyeye-trading-probe@.timer.tmpl"
)

usage() {
  printf '%s\n' \
    'Usage: scripts/trading-account add    --server ID --strategy NAME --executor NAME [--exchange NAME] [--dry-run] [transport]' \
    '       scripts/trading-account remove --server ID --strategy NAME --executor NAME [--exchange NAME] [--dry-run] [transport]' \
    '       scripts/trading-account list   --server ID --strategy NAME [transport]' \
    '' \
    'Manage executors (TQ_EXECUTOR_MAP) in an already-installed Linux Trading lane' \
    'without a repo PR, review, or central-deploy.' \
    '' \
    'Scope: Linux Trading lanes installed via agents/alloy/trading/setup-linux.sh' \
    'only (/etc/skyeye-trading/instances/<strategy>.env). macOS (Mac mini) and' \
    'Windows lanes are out of scope.' \
    '' \
    'Subcommands:' \
    '  add     Add one executor to TQ_EXECUTOR_MAP on the host, validate offline,' \
    '          reload Alloy (never restart), preserve probe timer state, and wait' \
    '          one probe cycle to verify .prom updates without errors.' \
    '          Omitting --exchange infers the exchange when all current executors' \
    '          share one exchange; multi-exchange lanes require --exchange.' \
    '  remove  Remove one executor from TQ_EXECUTOR_MAP (refuses removing the last' \
    '          executor). Passing --exchange verifies the existing mapping matches.' \
    '  list    Read-only: print TQ_EXECUTOR_MAP and executors currently emitting' \
    '          series in the strategy .prom file.' \
    '' \
    'Required / common options:' \
    '  --server ID         Target server_id (verified against TQ_SERVER_ID on host;' \
    '                      also used as default SSH target if --ssh-target is unset).' \
    '  --strategy NAME     Installed strategy slug.' \
    '  --executor NAME     Executor name (required for add/remove; rejected for list).' \
    '  --exchange NAME     Exchange label (optional for add/remove; rejected for list).' \
    '  --dry-run           Validate and print planned change without modifying host' \
    '                      (add/remove only).' \
    '  -h, --help          Show this help.' \
    '' \
    'Transport options (default: SSH to --ssh-target / --server, streaming allowlisted' \
    'agents/alloy/ files to a root-owned mode-0700 temp directory via sudo -n):' \
    '  --ssh-target HOST   SSH destination (default: SKYEYE_SSH_TARGET or --server).' \
    '  --remote-dir PATH   Run an existing checkout on the host instead of streaming' \
    '                      (default: SKYEYE_TRADING_REMOTE_DIR). Supports interactive sudo.' \
    '  --local             Run directly on the local host without SSH (mutually' \
    '                      exclusive with --ssh-target and --remote-dir).' \
    '' \
    'Required order with tnauqquant (SkyEye never touches tnauqquant@* units/configs/envs):' \
    '  Add:    1) scripts/trading-account add ... first' \
    '          2) Add the account in tnauqquant config/env and restart the lane' \
    '  Remove: 1) Remove the account in tnauqquant config/env and restart the lane first' \
    '          2) scripts/trading-account remove ...' \
    '' \
    'Guards & when to use the full workflow instead:' \
    '  - Mutating commands (add/remove) are refused during UTC 18:10-19:30.' \
    '  - Never overwrites shared probe.sh: if local probe.sh differs from the host,' \
    '    the command refuses and prints exact next steps.' \
    '  - Adding/retiring a strategy still requires scripts/trading-target + PR +' \
    '    scripts/central-deploy; updating shared probe.sh requires stopping all' \
    '    skyeye-trading-probe@* units first (see agents/alloy/trading/README.md).'
}

die() {
  printf 'trading-account: %s\n' "$*" >&2
  exit 1
}

valid_label_value() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]]
}

valid_remote_dir() {
  local dir="$1"
  [[ "$dir" =~ ^/[A-Za-z0-9_./-]+$ ]] || return 1
  case "/$dir/" in
    */../*) return 1 ;;
  esac
  return 0
}

valid_ssh_target() {
  local target="$1"
  [[ -n "$target" ]] || return 1
  [[ "$target" != -* ]] || return 1
  [[ "$target" != *[[:space:]]* ]] || return 1
  [[ "$target" =~ ^[A-Za-z0-9@._:%+-]+$ ]] || return 1
  return 0
}

shell_quote() {
  local s="$1"
  printf "'%s'" "${s//\'/\'\\\'\'}"
}

check_utc_window() {
  local now_hm hh mm total_min
  now_hm="$(date -u '+%H:%M')"
  [[ "$now_hm" =~ ^([0-9]{2}):([0-9]{2})$ ]] || \
    die "cannot determine current UTC time from 'date -u +%H:%M': $now_hm"
  hh="${BASH_REMATCH[1]}"
  mm="${BASH_REMATCH[2]}"
  total_min=$((10#$hh * 60 + 10#$mm))
  # Refuse UTC 18:10 (1090) through 19:30 (1170) inclusive.
  if [[ "$total_min" -ge 1090 && "$total_min" -le 1170 ]]; then
    die "refusing to modify trading accounts during the UTC 18:10-19:30 maintenance/restart window (current UTC: $now_hm). Retry after 19:30 UTC."
  fi
}

case "${1:-}" in
  add|remove|list)
    SUBCOMMAND="$1"
    shift
    ;;
  -h|--help)
    usage
    exit 0
    ;;
  "")
    usage >&2
    exit 2
    ;;
  *)
    die "unknown subcommand: $1 (expected add, remove, or list)"
    ;;
esac

SSH_TARGET_EXPLICIT=0
REMOTE_DIR_EXPLICIT=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --server)
      [[ $# -ge 2 ]] || die "--server requires a value"
      SERVER_ID="$2"
      shift 2
      ;;
    --strategy)
      [[ $# -ge 2 ]] || die "--strategy requires a value"
      STRATEGY="$2"
      shift 2
      ;;
    --executor)
      [[ $# -ge 2 ]] || die "--executor requires a value"
      EXECUTOR="$2"
      shift 2
      ;;
    --exchange)
      [[ $# -ge 2 ]] || die "--exchange requires a value"
      EXCHANGE="$2"
      shift 2
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --ssh-target)
      [[ $# -ge 2 ]] || die "--ssh-target requires a host"
      SSH_TARGET="$2"
      SSH_TARGET_EXPLICIT=1
      shift 2
      ;;
    --remote-dir)
      [[ $# -ge 2 ]] || die "--remote-dir requires a path"
      REMOTE_DIR="$2"
      REMOTE_DIR_EXPLICIT=1
      shift 2
      ;;
    --local)
      LOCAL_MODE=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

[[ -n "$SERVER_ID" ]] || die "--server is required"
valid_label_value "$SERVER_ID" || die "invalid --server: $SERVER_ID"
[[ -n "$STRATEGY" ]] || die "--strategy is required"
valid_label_value "$STRATEGY" || die "invalid --strategy: $STRATEGY"

if [[ "$SUBCOMMAND" == "list" ]]; then
  [[ -z "$EXECUTOR" ]] || die "list does not take --executor"
  [[ -z "$EXCHANGE" ]] || die "list does not take --exchange"
  [[ "$DRY_RUN" -eq 0 ]] || die "list does not take --dry-run"
else
  [[ -n "$EXECUTOR" ]] || die "--executor is required for $SUBCOMMAND"
  valid_label_value "$EXECUTOR" || die "invalid --executor: $EXECUTOR"
  if [[ -n "$EXCHANGE" ]]; then
    valid_label_value "$EXCHANGE" || die "invalid --exchange: $EXCHANGE"
  fi
fi

if [[ "$LOCAL_MODE" -eq 1 ]]; then
  [[ "$SSH_TARGET_EXPLICIT" -eq 0 ]] || die "--local and --ssh-target are mutually exclusive"
  [[ "$REMOTE_DIR_EXPLICIT" -eq 0 ]] || die "--local and --remote-dir are mutually exclusive"
fi

if [[ "$SUBCOMMAND" == "add" || "$SUBCOMMAND" == "remove" ]]; then
  check_utc_window
fi

ACCOUNT_ARGS=("$SUBCOMMAND" --server "$SERVER_ID" --strategy "$STRATEGY")
if [[ -n "$EXECUTOR" ]]; then
  ACCOUNT_ARGS+=(--executor "$EXECUTOR")
fi
if [[ -n "$EXCHANGE" ]]; then
  ACCOUNT_ARGS+=(--exchange "$EXCHANGE")
fi
if [[ "$DRY_RUN" -eq 1 ]]; then
  ACCOUNT_ARGS+=(--dry-run)
fi

if [[ "$LOCAL_MODE" -eq 1 ]]; then
  [[ -x "$LOCAL_SETUP" ]] || die "missing executable local setup script: $LOCAL_SETUP"
  exec "$LOCAL_SETUP" account "${ACCOUNT_ARGS[@]}"
fi

if [[ -z "$SSH_TARGET" ]]; then
  SSH_TARGET="$SERVER_ID"
fi
valid_ssh_target "$SSH_TARGET" || die "invalid --ssh-target: $SSH_TARGET"
command -v "$SSH_BIN" >/dev/null 2>&1 || die "missing ssh command: $SSH_BIN"

quoted_args=""
plain_args=""
for arg in "${ACCOUNT_ARGS[@]}"; do
  quoted_args="$quoted_args $(shell_quote "$arg")"
  plain_args="$plain_args $arg"
done

if [[ -n "$REMOTE_DIR" ]]; then
  valid_remote_dir "$REMOTE_DIR" || die "invalid --remote-dir (must be a clean absolute path without '..'): $REMOTE_DIR"
  remote_setup="$REMOTE_DIR/agents/alloy/trading/setup-linux.sh"
  remote_cmd="sudo -- $(shell_quote "$remote_setup") account$quoted_args"
  exec "$SSH_BIN" -- "$SSH_TARGET" "$remote_cmd"
fi

for rel_path in "${PAYLOAD_FILES[@]}"; do
  [[ -f "$REPO_ROOT/$rel_path" ]] || die "missing required payload file: $REPO_ROOT/$rel_path"
done

ERR_FILE="$(mktemp "${TMPDIR:-/tmp}/skyeye-trading-account-ssh.XXXXXX")"
# Invoked via EXIT trap below.
# shellcheck disable=SC2329
cleanup() {
  rm -f "$ERR_FILE"
}
trap cleanup EXIT

# Expanded by the remote bash -c invocation, not locally.
# shellcheck disable=SC2016
remote_script='set -euo pipefail; d=$(mktemp -d /tmp/skyeye-trading-account.XXXXXX); trap "rm -rf -- \"$d\"" EXIT; chmod 700 "$d"; tar -xf - -C "$d"; "$d/agents/alloy/trading/setup-linux.sh" account "$@"'
remote_cmd="sudo -n bash -c $(shell_quote "$remote_script") --$quoted_args"

ssh_rc=0
COPYFILE_DISABLE=1 tar --format ustar -C "$REPO_ROOT" -cf - "${PAYLOAD_FILES[@]}" \
  | "$SSH_BIN" -- "$SSH_TARGET" "$remote_cmd" 2>"$ERR_FILE" || ssh_rc=$?

if [[ -s "$ERR_FILE" ]]; then
  cat "$ERR_FILE" >&2
fi

if [[ "$ssh_rc" -ne 0 ]] && grep -qiE 'sudo:.*(password is required|no tty present|a terminal is required|interactive authentication required)' "$ERR_FILE"; then
  ssh_flag=""
  if [[ "$SSH_TARGET" != "$SERVER_ID" ]]; then
    ssh_flag=" --ssh-target $SSH_TARGET"
  fi
  printf '%s\n' \
    "trading-account: remote default mode requires passwordless sudo (sudo -n) on $SSH_TARGET." \
    "Next steps:" \
    "  1) Re-run against an existing checkout on the host (supports interactive sudo):" \
    "     scripts/trading-account$plain_args$ssh_flag --remote-dir /home/ubuntu/skyeye-staging/<CHECKOUT>" \
    "  2) Or SSH into $SSH_TARGET and run directly on the host:" \
    "     ssh $SSH_TARGET" \
    "     sudo <HOST_CHECKOUT>/agents/alloy/trading/setup-linux.sh account$plain_args" >&2
fi

exit "$ssh_rc"
