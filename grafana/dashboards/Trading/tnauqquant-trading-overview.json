er_id\",strategy=~\"$strategy\"} == bool 1) * 1) or (tnauqquant_target_info{product=\"tnauqquant\",environment=~\"$environment\",server_id=~\"$server_id\",strategy=~\"$strategy\"} * 0))",
          "instant": true,
