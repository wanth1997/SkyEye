    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "所有 production Trading 策略近 15 分鐘的高信心執行事故總數。大於 0 時先由下方策略表進入各策略詳情，再核對關鍵執行事件。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "pluginVersion": "11.2.0",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({product=\"tnauqquant\",environment=\"production\"} | logfmt | __error__=\"\" | msg=~\"coordinator_fence_stalled|mexcui_recovery_required|mexcui_recovery_required_refusing_normal_startup|shutdown_with_unconsumed_continuation|coordinated_shutdown_preserved_unresolved_fence\"[15m]))",
          "instant": true,
          "legendFormat": "需人工處理",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "執行事故 · 15 分鐘",
      "type": "stat"
    },
