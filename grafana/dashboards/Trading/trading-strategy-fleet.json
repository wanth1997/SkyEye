      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "count(trading_target_info{product=\"tnauqquant\",environment=\"production\"})",
          "instant": true,
          "legendFormat": "監控策略",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "count(trading_target_info{product=\"tnauqquant\",environment=\"production\"} unless on (product, environment, server_id, strategy) (time() - trading_strategy_probe_timestamp_seconds < 180)) or vector(0)",
          "instant": true,
          "legendFormat": "資料過期",
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(((trading_strategy_process_count != bool 1) and on (product, environment, server_id, strategy) (trading_strategy_run_expected == 1)) or ((trading_strategy_process_count != bool 0) and on (product, environment, server_id, strategy) (trading_strategy_run_expected == 0))) or vector(0)",
          "instant": true,
          "legendFormat": "程序異常",
          "range": false,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum((trading_strategy_run_expected == 1) and on (product, environment, server_id, strategy) (trading_strategy_runtime_contract_available == 0)) or vector(0)",
          "instant": true,
          "legendFormat": "Runtime 缺失",
          "range": false,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "count(ALERTS{alertname=~\"Trading.*\",alertstate=~\"pending|firing\",notification_mode=\"shadow\"}) or vector(0)",
          "instant": true,
          "legendFormat": "Prometheus SHADOW",
          "range": false,
          "refId": "E"
        }
      ],
      "title": "監控摘要",
      "type": "stat"
    },
