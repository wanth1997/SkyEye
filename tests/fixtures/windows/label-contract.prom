windows_net_route_info{nic="Fake Ethernet Controller",src="192.0.2.10",dest="0.0.0.0/0",metric="25"} 1
windows_service_state{name="Alloy",state="running"} 1
windows_service_start_mode{name="Alloy",start_mode="auto"} 1
windows_service_info{name="Alloy",display_name="Alloy",path_name="C:\\Fake\\alloy-service.exe",run_as="LocalSystem"} 1
windows_service_process{name="Alloy",process_id="4242"} 1.7947e+09
