[Unit]
Description=SkyEye trading telemetry probe (%i)
After=local-fs.target

[Service]
Type=oneshot
User=@@PROBE_USER@@
Group=@@PROBE_GROUP@@
EnvironmentFile=@@ENV_ROOT@@/%i.env
ExecStartPre=@@ACCESS_PATH@@
ExecStart=@@PROBE_PATH@@
UMask=0027
Nice=10
CPUWeight=20
CPUQuota=20%

[Install]
WantedBy=multi-user.target
