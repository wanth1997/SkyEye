# Copy to $(brew --prefix)/etc/alloy/config.env, replace every host-specific
# value, then chmod 600. Never commit the resulting config.env.

export TQ_PRODUCT=tnauqquant
export TQ_ENVIRONMENT=development
export TQ_SERVER_ID=tnauqquant-dev-mac
export TQ_STRATEGY=mexc-toobit-btc
export TQ_INSTANCE_ID=mexc-toobit-btc-initiator-hedge

export TQ_REPO_ROOT=/Users/operator/projects/tnauqquant
# Must be a RE2 expression with one capture group around the exact repo root.
export TQ_REPO_ROOT_REGEX='(/Users/operator/projects/tnauqquant)'
export TQ_EXECUTABLE=/Users/operator/projects/tnauqquant/quant
export TQ_CONFIG_PATH=/Users/operator/projects/tnauqquant/config/mexc_toobit_btc_config.yaml
export TQ_RAW_LOG_GLOB='/Users/operator/projects/tnauqquant/logs/live-runs/*.raw.log'
export TQ_RUN_MANIFEST=/Users/operator/projects/tnauqquant/run-state/mexc-toobit-btc/current.json
export TQ_DONE_MARKER=/Users/operator/projects/tnauqquant/run-state/mexc-toobit-btc/current.done.json

# Development heuristic only. Production derives expected state from the
# manifest/marker contract and still keeps this at 1 as its fallback.
export TQ_POC_RUN_EXPECTED=1
export TQ_TEXTFILE_DIR=/opt/homebrew/var/lib/alloy/trading-textfile

export TQ_SIDECAR_SESSION=goexchange-sidecar
export TQ_SIDECAR_IDENTITY_FILE=/Users/operator/projects/tnauqquant/logs/sidecar-runtime.identity
export TQ_SIDECAR_HEALTH_URL=http://127.0.0.1:3457/health

export LOKI_PUSH_URL=https://loki-push.wanbrain.com/loki/api/v1/push
export PROM_PUSH_URL=https://prom-push.wanbrain.com/api/v1/write

# Use a service token dedicated to this host. These placeholders are invalid.
export CF_ACCESS_CLIENT_ID=replace-with-trading-service-token-id
export CF_ACCESS_CLIENT_SECRET=replace-with-trading-service-token-secret
