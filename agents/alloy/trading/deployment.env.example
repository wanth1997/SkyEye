# Copy to $(brew --prefix)/etc/alloy/config.env, replace every host-specific
# value, then chmod 600. Never commit the resulting config.env.

export TQ_PRODUCT=tnauqquant
export TQ_ENVIRONMENT=production
export TQ_SERVER_ID=tnauqquant-prod-1
export TQ_STRATEGY=toobit-mexc-btc
export TQ_INSTANCE_ID=mexc-toobit-btc-initiator-hedge

export TQ_REPO_ROOT=/Users/wan/projects/tnauqquant
# Must be a RE2 expression with one capture group around the exact repo root.
export TQ_REPO_ROOT_REGEX='(/Users/wan/projects/tnauqquant)'
export TQ_EXECUTABLE=/Users/wan/projects/tnauqquant/quant
export TQ_CONFIG_PATH=/Users/wan/projects/tnauqquant/config/toobit-mexc.conf
export TQ_RAW_LOG_GLOB='/Users/wan/projects/tnauqquant/logs/live-runs/*.raw.log'
export TQ_RUN_MANIFEST=/Users/wan/projects/tnauqquant/run-state/toobit-mexc-btc/current.json
export TQ_DONE_MARKER=/Users/wan/projects/tnauqquant/run-state/toobit-mexc-btc/current.done.json

# Development heuristic only. Production derives expected state from the
# manifest/marker contract and still keeps this at 1 as its fallback.
export TQ_POC_RUN_EXPECTED=1
export TQ_REQUIRE_RUNTIME_CONTRACT=1
export TQ_TIMEZONE=Asia/Taipei
export TQ_TEXTFILE_DIR=/opt/homebrew/var/lib/alloy/trading-textfile
# Map runtime executor IDs to bounded Prometheus exchange labels.
export TQ_EXECUTOR_MAP=toobit-main=toobit,mexc-ui=mexc
# Set to 0 for strategies such as Lighter that do not use goexchange-sidecar.
export TQ_SIDECAR_REQUIRED=1
# macOS probe and Alloy run as the same user; Linux coexistence uses 640.
export TQ_TEXTFILE_MODE=600

export TQ_SIDECAR_SESSION=goexchange-sidecar
export TQ_SIDECAR_IDENTITY_FILE=/Users/wan/projects/tnauqquant/logs/sidecar-runtime.identity
export TQ_SIDECAR_HEALTH_URL=http://127.0.0.1:3457/health
export TQ_TMUX_PATH=/opt/homebrew/bin/tmux
export TQ_CURL_PATH=/usr/bin/curl

export LOKI_PUSH_URL=https://loki-push.wanbrain.com/loki/api/v1/push
export PROM_PUSH_URL=https://prom-push.wanbrain.com/api/v1/write

# Use a service token dedicated to this host. These placeholders are invalid.
export CF_ACCESS_CLIENT_ID=replace-with-trading-service-token-id
export CF_ACCESS_CLIENT_SECRET=replace-with-trading-service-token-secret
