# Install as /etc/skyeye-trading/instances/popdex-multi-accounts.env
# with mode 600. This file contains no central credentials.
# popdex-multi-accounts trades BTC_USDT_PERP on PopDEX using routing.mode=random
# across two dedicated accounts: popdex-main (reused from popdex-btc) and
# popdex-rot2 (new account). Merged equity, P&L, volume and net position appear
# under strategy="popdex-multi-accounts" / exchange="popdex", and per-account
# breakdown series carry low-cardinality executor labels from TQ_EXECUTOR_MAP.
#
# Verify TQ_EXECUTABLE against TNAUQ_EXPECTED_BIN in
# /etc/tnauqquant/instances/popdex-multi-accounts/manager.env on Trading01
# before running setup-linux.sh add.
# Procedure: docs/trading01-popdex-multi-accounts-onboarding.md

TQ_PRODUCT=tnauqquant
TQ_ENVIRONMENT=production
TQ_SERVER_ID=trading01
TQ_STRATEGY=popdex-multi-accounts
# Confirmed by tnauqquant side; verify against instance_id in
# popdex_multi_accounts_config.yaml on Trading01 before installation.
TQ_INSTANCE_ID=popdex-multi-accounts

TQ_REPO_ROOT=/home/ubuntu/tnauqquant
TQ_REPO_ROOT_REGEX='(/home/ubuntu/tnauqquant)'
# Verify the absolute path before installation and exclude directories, the
# shared launcher /usr/local/sbin/tnauqquant-service and sibling executables.
# The first lane start may create the binary. During canary, require an
# executable regular file and match the manifest executable to this path.
# Never read the lane env file.
TQ_EXECUTABLE=/home/ubuntu/tnauqquant/bin/popdex-multi-accounts/quant
TQ_CONFIG_PATH=/home/ubuntu/tnauqquant/config/popdex_multi_accounts_config.yaml
# CONTRACT-NAMED LOGS ONLY. The runtime contract names a raw log
# YYYYMMDD_HHMMSS_<config stem>.raw.log. This pattern matches that name and
# nothing else, so another file in the same directory whose name only ends the
# same way is neither tailed as popdex-multi-accounts nor counted by its probe.
# tests/trading/test-linux-env-examples.sh holds every Linux example to this
# pattern.
TQ_RAW_LOG_GLOB=/home/ubuntu/tnauqquant/logs/live-runs/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9]_popdex_multi_accounts_config.raw.log
TQ_RUN_MANIFEST=/home/ubuntu/tnauqquant/run-state/popdex-multi-accounts/current.json
TQ_DONE_MARKER=/home/ubuntu/tnauqquant/run-state/popdex-multi-accounts/current.done.json

TQ_POC_RUN_EXPECTED=1
# The lane is installed disabled and stays disabled until Wan completes the
# manual canary cycle and decides to switch over from popdex-btc. While this is
# 1 the probe reports run_expected=0, so a stopped lane raises nothing and the
# manual canary cycle shows as shadow TradingUnexpectedProcess. Set 0 with
# setup-linux.sh add before the lane is enabled for production.
TQ_STRATEGY_DISABLED=1
TQ_REQUIRE_RUNTIME_CONTRACT=1
TQ_TIMEZONE=Asia/Taipei
TQ_TEXTFILE_DIR=/var/lib/skyeye-trading/textfile
TQ_TEXTFILE_NAME=tnauqquant-popdex-multi-accounts.prom
# Both routing.accounts[].name entries on PopDEX map to exchange="popdex".
# Verify both names against popdex_multi_accounts_config.yaml on Trading01.
TQ_EXECUTOR_MAP=popdex-main=popdex,popdex-rot2=popdex
TQ_SIDECAR_REQUIRED=0
TQ_TEXTFILE_MODE=640

TQ_PROBE_USER=ubuntu
TQ_PROBE_GROUP=ubuntu
TQ_ALLOY_USER=alloy
TQ_ALLOY_GROUP=alloy
