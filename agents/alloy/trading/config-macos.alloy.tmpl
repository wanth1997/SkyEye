// SkyEye tnauqquant monitoring for macOS.
// Secrets and server-specific values are read from Homebrew Alloy config.env.

loki.source.file "trading_raw" {
  targets = [
    {
      __path__    = sys.env("TQ_RAW_LOG_GLOB"),
      product     = sys.env("TQ_PRODUCT"),
      environment = sys.env("TQ_ENVIRONMENT"),
      server_id   = sys.env("TQ_SERVER_ID"),
      strategy    = sys.env("TQ_STRATEGY"),
    },
  ]

  tail_from_end           = false
  on_positions_file_error = "restart_from_end"
  forward_to              = [loki.process.trading.receiver]

  file_match {
    enabled           = true
    sync_period       = "10s"
    ignore_older_than = "24h"
  }
}

loki.process "trading" {
  forward_to = [loki.write.central.receiver]

  stage.logfmt {
    mapping = {
      time               = "",
      level              = "",
      msg                = "",
      stable             = "",
      cycle_completed    = "",
      cycle_id           = "",
      real_pnl_usdt      = "",
      cash_pnl_usdt      = "",
      rebate_usdt        = "",
      risk_pnl_usdt      = "",
      cycles_completed   = "",
      cycles_completed_today = "",
      process_latency_ms = "",
    }
  }

  stage.timestamp {
    source                        = "time"
    format                        = "RFC3339Nano"
    action_on_failure             = "skip"
    action_on_duplicate_timestamp = "fudge"
  }

  // Keep the original path only long enough to derive a basename run_id.
  stage.regex {
    source     = "filename"
    expression = "^.*/(?P<run_id>[^/]+)\\.raw\\.log$"
  }

  stage.labels {
    values = {
      level  = "",
      run_id = "",
    }
  }

  // Scrub on the source host before the line can reach Loki.
  stage.replace {
    expression = sys.env("TQ_REPO_ROOT_REGEX")
    replace    = "[REPO_ROOT]"
  }

  stage.replace {
    expression = "([A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,})"
    replace    = "[EMAIL]"
  }

  // Every expression has one capture group, around the value, because stage.replace
  // rewrites capture groups and nothing else. A value is tried as an escaped \"...\",
  // a "..." that may run to the end of the line, a '...', a [...] list, then a bare
  // word. A quote followed by a space closes an enclosing value rather than opening
  // one, and a bare word stops at a quote: eating that quote would swallow the rest
  // of the line, msg included.

  // Bare bearer credential. It runs first so that a key with its own rule, such as
  // X-Auth-Token: Bearer x, cannot redact the scheme and leave the credential.
  stage.replace {
    expression = `(?i)\bbearer\s+((?:[^\s"\\]|\\[^"])+)`
    replace    = "[TOKEN]"
  }

  // Scheme plus credential: redact both words, not just the scheme.
  stage.replace {
    expression = `(?i)authorization(?:\\*["'])?\s*[=:]\s*\[?((?:bearer|basic|token|digest|negotiate|apikey)\s+(?:[^\s"\\]|\\[^"])+)`
    replace    = "[TOKEN]"
  }

  // Unknown scheme. A second word containing = is the next logfmt key, so it is left alone.
  stage.replace {
    expression = `(?i)authorization(?:\\*["'])?\s*[=:]\s*\[?([A-Za-z][A-Za-z0-9_.+\-]*[ \t]+[^\s"\\=]+)(?:[\s"\\\]]|$)`
    replace    = "[TOKEN]"
  }

  stage.replace {
    expression = `(?i)authorization(?:\\*["'])?\s*[=:]\s*(\\+"(?:[^"\\]|\\+[^"\\])*\\+"|"(?:[^\s"\\]|\\.)(?:[^"\\]|\\.)*(?:"|$)|'[^'"]*'|\[[^\]]*\]|(?:[^\s"\\]|\\[^"])+)`
    replace    = "[TOKEN]"
  }

  stage.replace {
    expression = `(?i)token(?:\\*["'])?\s*[=:]\s*(\\+"(?:[^"\\]|\\+[^"\\])*\\+"|"(?:[^\s"\\]|\\.)(?:[^"\\]|\\.)*(?:"|$)|'[^'"]*'|\[[^\]]*\]|(?:[^\s"\\]|\\[^"])+)`
    replace    = "[TOKEN]"
  }

  stage.replace {
    expression = `(?i)(?:order_?id|client_?action_?id)(?:\\*["'])?\s*[=:]\s*(\\+"(?:[^"\\]|\\+[^"\\])*\\+"|"(?:[^\s"\\]|\\.)(?:[^"\\]|\\.)*(?:"|$)|'[^'"]*'|\[[^\]]*\]|(?:[^\s"\\]|\\[^"])+)`
    replace    = "[ORDER_REF]"
  }

  stage.replace {
    expression = `(?i)(?:attempt_id|parent_attempt_id|reservation_id|linked_reservation_id|recovery_group_id)(?:\\*["'])?\s*[=:]\s*(\\+"(?:[^"\\]|\\+[^"\\])*\\+"|"(?:[^\s"\\]|\\.)(?:[^"\\]|\\.)*(?:"|$)|'[^'"]*'|\[[^\]]*\]|(?:[^\s"\\]|\\[^"])+)`
    replace    = "[TRACE_REF]"
  }

  stage.replace {
    expression = `(?i)(?:grant_id|mutation_id|mutations|account)(?:\\*["'])?\s*[=:]\s*(\\+"(?:[^"\\]|\\+[^"\\])*\\+"|"(?:[^\s"\\]|\\.)(?:[^"\\]|\\.)*(?:"|$)|'[^'"]*'|\[[^\]]*\]|(?:[^\s"\\]|\\[^"])+)`
    replace    = "[EXECUTION_REF]"
  }

  stage.replace {
    expression = `(?i)(?:api[_-]?secret|client[_-]?secret|secret[_-]?key|secret|passw(?:or)?d|passphrase|private[_-]?key|signature)(?:\\*["'])?\s*[=:]\s*(\\+"(?:[^"\\]|\\+[^"\\])*\\+"|"(?:[^\s"\\]|\\.)(?:[^"\\]|\\.)*(?:"|$)|'[^'"]*'|\[[^\]]*\]|(?:[^\s"\\]|\\[^"])+)`
    replace    = "[SECRET]"
  }

  // At least 12 characters: loki/rules/fake/zenincome.yml alerts on the literal text
  // of an invalid-key error, which this rule must leave readable.
  stage.replace {
    expression = `(?i)api[_-]?key(?:\\*["'])?\s*[=:]\s*(\\+"(?:[^"\\]|\\+[^"\\]){12,}\\+"|"(?:[^\s"\\]|\\.)(?:[^"\\]|\\.){11,}(?:"|$)|(?:[^\s"\\]|\\[^"]){12,})`
    replace    = "[SECRET]"
  }

  stage.replace {
    expression = `(?i)cookie(?:\\*["'])?\s*[=:]\s*(\\+"(?:[^"\\]|\\+[^"\\])*\\+"|"(?:[^\s"\\]|\\.)(?:[^"\\]|\\.)*(?:"|$)|'[^'"]*'|(?:[^\s;"\\]+;\s*)*[^\s"\\]+)`
    replace    = "[SECRET]"
  }

  stage.label_drop {
    values = ["filename"]
  }

  // This is the complete cardinality budget for trading log streams.
  stage.label_keep {
    values = ["product", "environment", "server_id", "strategy", "run_id", "level"]
  }
}

loki.write "central" {
  endpoint {
    url = sys.env("LOKI_PUSH_URL")
    headers = {
      "CF-Access-Client-Id"     = sys.env("CF_ACCESS_CLIENT_ID"),
      "CF-Access-Client-Secret" = sys.env("CF_ACCESS_CLIENT_SECRET"),
    }
  }
}

prometheus.exporter.unix "trading_textfile" {
  set_collectors = ["textfile"]

  textfile {
    directory = sys.env("TQ_TEXTFILE_DIR")
  }
}

prometheus.scrape "trading_probe" {
  targets         = prometheus.exporter.unix.trading_textfile.targets
  forward_to      = [prometheus.remote_write.central.receiver]
  scrape_interval = "15s"
  scrape_timeout  = "10s"
  job_name        = "tnauqquant-trading-probe"
}

prometheus.remote_write "central" {
  endpoint {
    url = sys.env("PROM_PUSH_URL")
    headers = {
      "CF-Access-Client-Id"     = sys.env("CF_ACCESS_CLIENT_ID"),
      "CF-Access-Client-Secret" = sys.env("CF_ACCESS_CLIENT_SECRET"),
    }

    queue_config {
      max_samples_per_send = 2000
      batch_send_deadline  = "5s"
      min_backoff          = "500ms"
      max_backoff          = "30s"
    }
  }

  external_labels = {
    product     = sys.env("TQ_PRODUCT"),
    environment = sys.env("TQ_ENVIRONMENT"),
    server_id   = sys.env("TQ_SERVER_ID"),
    strategy    = sys.env("TQ_STRATEGY"),
  }
}

logging {
  level  = "info"
  format = "logfmt"
}
