// SkyEye trading fragment for a Linux host with an existing Alloy deployment.
// The central write receivers are defined by the host's base Alloy config.

loki.source.file "@@COMPONENT_ID@@_raw" {
  targets = [
    {
      __path__    = "@@RAW_LOG_GLOB@@",
      product     = "@@PRODUCT@@",
      environment = "@@ENVIRONMENT@@",
      server_id   = "@@SERVER_ID@@",
      strategy    = "@@STRATEGY@@",
    },
  ]

  tail_from_end           = false
  on_positions_file_error = "restart_from_end"
  forward_to              = [loki.process.@@COMPONENT_ID@@.receiver]

  file_match {
    enabled           = true
    sync_period       = "10s"
    ignore_older_than = "24h"
  }
}

loki.process "@@COMPONENT_ID@@" {
  forward_to = [loki.write.central.receiver]

  stage.logfmt {
    mapping = {
      time                   = "",
      level                  = "",
      msg                    = "",
      stable                 = "",
      cycle_completed        = "",
      cycle_id               = "",
      real_pnl_usdt          = "",
      cash_pnl_usdt          = "",
      rebate_usdt            = "",
      risk_pnl_usdt          = "",
      cycles_completed       = "",
      cycles_completed_today = "",
      process_latency_ms     = "",
    }
  }

  stage.timestamp {
    source            = "time"
    format            = "RFC3339Nano"
    action_on_failure = "skip"
  }

  stage.regex {
    source     = "filename"
    expression = "^.*/(?P<run_id>[^/]+)\\.raw\\.log$"
  }

  stage.labels {
    values = {
      level  = "",
      run_id = "",
    }
  }

  stage.replace {
    expression = "@@REPO_ROOT_REGEX@@"
    replace    = "[REPO_ROOT]"
  }

  stage.replace {
    expression = "([A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,})"
    replace    = "[EMAIL]"
  }

  // stage.replace rewrites capture groups and nothing else, so a group wraps a value and
  // never its key. A branch with no group matches text that must stay: RE2 has no
  // lookahead, and this is how an expression says "not this". Where an expression has
  // two groups they are alternatives, and only one takes part in a match.
  //
  // A value is tried as an escaped \"...\", a "..." that may run to the end of the line,
  // a '...', a [...] or {...} composite, then a bare word. A bare word stops at a quote:
  // eating it would swallow the rest of the line, msg included.
  //
  // A quote followed by a space usually closes an enclosing value, as in
  // err="bad token: " detail=x. It opens a value only when the next quote is followed by
  // a delimiter, as in token=" x".
  //
  // Composites balance up to four levels, spelled out because RE2 cannot recurse. A value
  // nested deeper, or never closed, is redacted through the last ] or } on the line, or
  // to the end of the line when there is none, and a quote followed by a space stops it
  // either way. A ] or } inside the data closes a composite early.
  //
  // The next field is a lowercase key, =, and a value. It stays after key= and a space,
  // and after a bare scheme such as Bearer. A credential ending in = padding is not one.

  // Python header tuples, ('Authorization', 'Basic x'). The opening ( keeps this off
  // JSON, where "token","next" is a value followed by the next key.
  stage.replace {
    expression = `(?i)[(\[]\s*\\*["'][\w.\-]*(?:authorization|token|cookie|api[_-]?key|secret(?:[_-]?key)?|passw(?:or)?d|passphrase|private[_-]?key|signature)\\*["']\s*,\s*(\\+"(?:[^"\\]|\\+[^"\\])*\\+"|"(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.)*')`
    replace    = "[SECRET]"
  }

  // Scheme plus credential: redact both words, not just the scheme. Tried in order: a
  // comma separated parameter list (Digest, AWS4-HMAC-SHA256), the next field, which
  // stays, then a credential with any further scheme and credential pairs after it.
  stage.replace {
    expression = `(?i)authorization(?:\\*["'])?\s*[=:]\s*\[?(?:([A-Za-z][A-Za-z0-9_.+\-]*\s+[A-Za-z0-9_.\-]+=(?:\\+"(?:[^"\\]|\\+[^"\\])*\\+"|"(?:[^"\\]|\\.)*"|[^\s",\\]*)\s*,\s*[A-Za-z0-9_.\-]+=(?:\\+"(?:[^"\\]|\\+[^"\\])*\\+"|"(?:[^"\\]|\\.)*"|[^\s",\\]*)(?:\s*,\s*[A-Za-z0-9_.\-]+=(?:\\+"(?:[^"\\]|\\+[^"\\])*\\+"|"(?:[^"\\]|\\.)*"|[^\s",\\]*))*)|[A-Za-z][A-Za-z0-9_.+\-]*\s+(?-i:[a-z_][a-z0-9_.]*)=(?:[^\s='"\\,;)}\]]|["'][^\s,;)}\]])|([A-Za-z][A-Za-z0-9_.+\-]*\s+(?:[^\s"\\,]|\\[^"])+(?:\s*,\s*(?:bearer|basic|token|digest|negotiate|apikey)\s+(?:[^\s"\\,]|\\[^"])+|,(?:[^\s"\\,]|\\[^"])+)*))`
    replace    = "[TOKEN]"
  }

  stage.replace {
    expression = `(?i)authorization(?:\\*["'])?\s*(?:=\s+(?-i:[a-z_][a-z0-9_.]*)=(?:[^\s='"\\,;)}\]]|["'][^\s,;)}\]])|[=:]\s*(?:(\\+"(?:[^"\\]|\\+[^"\\])*\\+"|"(?:[^\s"\\]|\\.)(?:[^"\\]|\\.)*(?:"|$)|'(?:[^'\\]|\\.)*'|(?:[\w.&*]*[\[{](?:[^\[\]{}]|[\[{](?:[^\[\]{}]|[\[{](?:[^\[\]{}]|[\[{][^\[\]{}]*[\]}])*[\]}])*[\]}])*[\]}])+[^\s"\\]*|&?(?:map)?[\[{](?:[^\s"\]}]|"\S)(?:(?:[^"]|"\S)*[\]}]|(?:[^"]|"\S)*)|(?:[^\s"\\]|\\[^"])+)|("\s(?:[^"\\]|\\.)*")(?:[\s,;)}\]]|$)))`
    replace    = "[TOKEN]"
  }

  // Bare bearer credential. It runs before the token rule so that X-Auth-Token: Bearer x
  // cannot redact the scheme and leave the credential.
  stage.replace {
    expression = `(?i)\bbearer\s+(?:(?-i:[a-z_][a-z0-9_.]*)=(?:[^\s='"\\,;)}\]]|["'][^\s,;)}\]])|((?:[^\s"\\]|\\[^"])+))`
    replace    = "[TOKEN]"
  }

  stage.replace {
    expression = `(?i)token(?:\\*["'])?\s*(?:=\s+(?-i:[a-z_][a-z0-9_.]*)=(?:[^\s='"\\,;)}\]]|["'][^\s,;)}\]])|[=:]\s*(?:(\\+"(?:[^"\\]|\\+[^"\\])*\\+"|"(?:[^\s"\\]|\\.)(?:[^"\\]|\\.)*(?:"|$)|'(?:[^'\\]|\\.)*'|(?:[\w.&*]*[\[{](?:[^\[\]{}]|[\[{](?:[^\[\]{}]|[\[{](?:[^\[\]{}]|[\[{][^\[\]{}]*[\]}])*[\]}])*[\]}])*[\]}])+[^\s"\\]*|&?(?:map)?[\[{](?:[^\s"\]}]|"\S)(?:(?:[^"]|"\S)*[\]}]|(?:[^"]|"\S)*)|(?:[^\s"\\]|\\[^"])+)|("\s(?:[^"\\]|\\.)*")(?:[\s,;)}\]]|$)))`
    replace    = "[TOKEN]"
  }

  stage.replace {
    expression = `(?i)(?:order_?id|client_?action_?id)(?:\\*["'])?\s*(?:=\s+(?-i:[a-z_][a-z0-9_.]*)=(?:[^\s='"\\,;)}\]]|["'][^\s,;)}\]])|[=:]\s*(?:(\\+"(?:[^"\\]|\\+[^"\\])*\\+"|"(?:[^\s"\\]|\\.)(?:[^"\\]|\\.)*(?:"|$)|'(?:[^'\\]|\\.)*'|(?:[\w.&*]*[\[{](?:[^\[\]{}]|[\[{](?:[^\[\]{}]|[\[{](?:[^\[\]{}]|[\[{][^\[\]{}]*[\]}])*[\]}])*[\]}])*[\]}])+[^\s"\\]*|&?(?:map)?[\[{](?:[^\s"\]}]|"\S)(?:(?:[^"]|"\S)*[\]}]|(?:[^"]|"\S)*)|(?:[^\s"\\]|\\[^"])+)|("\s(?:[^"\\]|\\.)*")(?:[\s,;)}\]]|$)))`
    replace    = "[ORDER_REF]"
  }

  stage.replace {
    expression = `(?i)(?:attempt_id|parent_attempt_id|reservation_id|linked_reservation_id|recovery_group_id)(?:\\*["'])?\s*(?:=\s+(?-i:[a-z_][a-z0-9_.]*)=(?:[^\s='"\\,;)}\]]|["'][^\s,;)}\]])|[=:]\s*(?:(\\+"(?:[^"\\]|\\+[^"\\])*\\+"|"(?:[^\s"\\]|\\.)(?:[^"\\]|\\.)*(?:"|$)|'(?:[^'\\]|\\.)*'|(?:[\w.&*]*[\[{](?:[^\[\]{}]|[\[{](?:[^\[\]{}]|[\[{](?:[^\[\]{}]|[\[{][^\[\]{}]*[\]}])*[\]}])*[\]}])*[\]}])+[^\s"\\]*|&?(?:map)?[\[{](?:[^\s"\]}]|"\S)(?:(?:[^"]|"\S)*[\]}]|(?:[^"]|"\S)*)|(?:[^\s"\\]|\\[^"])+)|("\s(?:[^"\\]|\\.)*")(?:[\s,;)}\]]|$)))`
    replace    = "[TRACE_REF]"
  }

  stage.replace {
    expression = `(?i)(?:grant_id|mutation_id|mutations|account)(?:\\*["'])?\s*(?:=\s+(?-i:[a-z_][a-z0-9_.]*)=(?:[^\s='"\\,;)}\]]|["'][^\s,;)}\]])|[=:]\s*(?:(\\+"(?:[^"\\]|\\+[^"\\])*\\+"|"(?:[^\s"\\]|\\.)(?:[^"\\]|\\.)*(?:"|$)|'(?:[^'\\]|\\.)*'|(?:[\w.&*]*[\[{](?:[^\[\]{}]|[\[{](?:[^\[\]{}]|[\[{](?:[^\[\]{}]|[\[{][^\[\]{}]*[\]}])*[\]}])*[\]}])*[\]}])+[^\s"\\]*|&?(?:map)?[\[{](?:[^\s"\]}]|"\S)(?:(?:[^"]|"\S)*[\]}]|(?:[^"]|"\S)*)|(?:[^\s"\\]|\\[^"])+)|("\s(?:[^"\\]|\\.)*")(?:[\s,;)}\]]|$)))`
    replace    = "[EXECUTION_REF]"
  }

  stage.replace {
    expression = `(?i)(?:api[_-]?secret|client[_-]?secret|secret[_-]?key|secret|passw(?:or)?d|passphrase|private[_-]?key|signature)(?:\\*["'])?\s*(?:=\s+(?-i:[a-z_][a-z0-9_.]*)=(?:[^\s='"\\,;)}\]]|["'][^\s,;)}\]])|[=:]\s*(?:(\\+"(?:[^"\\]|\\+[^"\\])*\\+"|"(?:[^\s"\\]|\\.)(?:[^"\\]|\\.)*(?:"|$)|'(?:[^'\\]|\\.)*'|(?:[\w.&*]*[\[{](?:[^\[\]{}]|[\[{](?:[^\[\]{}]|[\[{](?:[^\[\]{}]|[\[{][^\[\]{}]*[\]}])*[\]}])*[\]}])*[\]}])+[^\s"\\]*|&?(?:map)?[\[{](?:[^\s"\]}]|"\S)(?:(?:[^"]|"\S)*[\]}]|(?:[^"]|"\S)*)|(?:[^\s"\\]|\\[^"])+)|("\s(?:[^"\\]|\\.)*")(?:[\s,;)}\]]|$)))`
    replace    = "[SECRET]"
  }

  // At least 12 characters: loki/rules/fake/zenincome.yml alerts on the literal text
  // of an invalid-key error, which this rule must leave readable.
  stage.replace {
    expression = `(?i)api[_-]?key(?:\\*["'])?\s*(?:=\s+(?-i:[a-z_][a-z0-9_.]*)=(?:[^\s='"\\,;)}\]]|["'][^\s,;)}\]])|[=:]\s*(?:(\\+"(?:[^"\\]|\\+[^"\\]){12,}\\+"|"(?:[^\s"\\]|\\.)(?:[^"\\]|\\.){11,}(?:"|$)|'(?:[^'\\]|\\.){12,}'|(?:[\w.&*]*[\[{](?:[^\[\]{}]|[\[{](?:[^\[\]{}]|[\[{](?:[^\[\]{}]|[\[{][^\[\]{}]*[\]}])*[\]}])*[\]}])*[\]}])+[^\s"\\]*|(?:[^\s"\\]|\\[^"]){12,})|("\s(?:[^"\\]|\\.){11,}")(?:[\s,;)}\]]|$)))`
    replace    = "[SECRET]"
  }

  stage.replace {
    expression = `(?i)cookie(?:\\*["'])?\s*(?:=\s+(?-i:[a-z_][a-z0-9_.]*)=(?:[^\s='"\\,;)}\]]|["'][^\s,;)}\]])|[=:]\s*(?:(\\+"(?:[^"\\]|\\+[^"\\])*\\+"|"(?:[^\s"\\]|\\.)(?:[^"\\]|\\.)*(?:"|$)|'(?:[^'\\]|\\.)*'|(?:[^\s;"\\]+;\s*)*[^\s"\\]+)|("\s(?:[^"\\]|\\.)*")(?:[\s,;)}\]]|$)))`
    replace    = "[SECRET]"
  }

  stage.label_drop {
    values = ["filename"]
  }

  stage.label_keep {
    values = ["product", "environment", "server_id", "strategy", "run_id", "level"]
  }
}
