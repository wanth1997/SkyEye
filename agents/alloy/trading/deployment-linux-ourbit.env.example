# Install as /etc/skyeye-trading/instances/ourbit-spot.env
# with mode 600. This file contains no central credentials.

TQ_PRODUCT=tnauqquant
TQ_ENVIRONMENT=production
TQ_SERVER_ID=trading01
TQ_STRATEGY=ourbit-spot
TQ_INSTANCE_ID=ourbit-spot-btc

TQ_REPO_ROOT=/home/ubuntu/tnauqquant
TQ_REPO_ROOT_REGEX='(/home/ubuntu/tnauqquant)'
TQ_EXECUTABLE=/home/ubuntu/.local/share/tnauqquant/ourbit-spot/quant
TQ_CONFIG_PATH=/home/ubuntu/tnauqquant/config/ourbit_spot_config.yaml
TQ_RAW_LOG_GLOB=/home/ubuntu/tnauqquant/logs/live-runs/*ourbit_spot_config.raw.log
TQ_RUN_MANIFEST=/home/ubuntu/tnauqquant/run-state/ourbit-spot/current.json
TQ_DONE_MARKER=/home/ubuntu/tnauqquant/run-state/ourbit-spot/current.done.json

TQ_POC_RUN_EXPECTED=1
TQ_REQUIRE_RUNTIME_CONTRACT=1
TQ_TIMEZONE=Asia/Taipei
TQ_TEXTFILE_DIR=/var/lib/skyeye-trading/textfile
TQ_TEXTFILE_NAME=tnauqquant-ourbit-spot.prom
TQ_EXECUTOR_MAP=ourbit-spot=ourbit
TQ_SIDECAR_REQUIRED=0
TQ_TEXTFILE_MODE=640

TQ_PROBE_USER=ubuntu
TQ_PROBE_GROUP=ubuntu
TQ_ALLOY_USER=alloy
TQ_ALLOY_GROUP=alloy
