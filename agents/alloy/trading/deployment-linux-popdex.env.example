# Install as /etc/skyeye-trading/instances/popdex-btc.env
# with mode 600. This file contains no central credentials.
# popdex-btc trades BTC on PopDEX through one executor, popdex-main, so its
# volume, P&L and net position appear as exchange="popdex".

TQ_PRODUCT=tnauqquant
TQ_ENVIRONMENT=production
TQ_SERVER_ID=trading01
TQ_STRATEGY=popdex-btc
TQ_INSTANCE_ID=popdex-btc

TQ_REPO_ROOT=/home/ubuntu/tnauqquant
TQ_REPO_ROOT_REGEX='(/home/ubuntu/tnauqquant)'
TQ_EXECUTABLE=/home/ubuntu/tnauqquant/bin/popdex-btc/quant
TQ_CONFIG_PATH=/home/ubuntu/tnauqquant/config/popdex_btc_config.yaml
TQ_RAW_LOG_GLOB=/home/ubuntu/tnauqquant/logs/live-runs/*popdex_btc_config.raw.log
TQ_RUN_MANIFEST=/home/ubuntu/tnauqquant/run-state/popdex-btc/current.json
TQ_DONE_MARKER=/home/ubuntu/tnauqquant/run-state/popdex-btc/current.done.json

TQ_POC_RUN_EXPECTED=1
TQ_REQUIRE_RUNTIME_CONTRACT=1
TQ_TIMEZONE=Asia/Taipei
TQ_TEXTFILE_DIR=/var/lib/skyeye-trading/textfile
TQ_TEXTFILE_NAME=tnauqquant-popdex-btc.prom
TQ_EXECUTOR_MAP=popdex-main=popdex
TQ_SIDECAR_REQUIRED=0
TQ_TEXTFILE_MODE=640

TQ_PROBE_USER=ubuntu
TQ_PROBE_GROUP=ubuntu
TQ_ALLOY_USER=alloy
TQ_ALLOY_GROUP=alloy
