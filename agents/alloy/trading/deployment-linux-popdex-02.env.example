# Install as /etc/skyeye-trading/instances/popdex-02.env
# with mode 600. This file contains no central credentials.
# popdex-02 trades ETH_USDT_PERP on PopDEX with its own account
# (tnauqquant@popdex-02.service), so its volume, P&L and net position appear
# as exchange="popdex". Its position quantities are ETH: the producer kept the
# *_btc field names, so the position metrics and panels still say BTC.
#
# NOT INSTALLABLE AS CHECKED IN. TQ_EXECUTABLE and TQ_EXECUTOR_MAP are empty
# because SkyEye has not verified them on the host, and setup-linux.sh refuses
# an empty value. The producer (tnauqquant) has reported both values; they are
# in the comments below. Fill each one after its read-only check on Trading01.
# Procedure: docs/trading01-popdex-02-onboarding.md

TQ_PRODUCT=tnauqquant
TQ_ENVIRONMENT=production
TQ_SERVER_ID=trading01
TQ_STRATEGY=popdex-02
# Expected, not verified. It must equal instance_id in popdex_02_config.yaml
# and differ from every other instance on the host. If the config says another
# value, put that value here; never change the config to match this file.
TQ_INSTANCE_ID=popdex-02

TQ_REPO_ROOT=/home/ubuntu/tnauqquant
TQ_REPO_ROOT_REGEX='(/home/ubuntu/tnauqquant)'
# UNVERIFIED on the host, operator fills in: the absolute path of this lane's
# quant binary. It is not the unit's ExecStart: every lane starts through the
# shared launcher /usr/local/sbin/tnauqquant-service, which is the same path
# for all of them and is not the image of the trading process. The producer
# reports /home/ubuntu/tnauqquant/bin/popdex-02/quant (the layout popdex-btc
# uses), recorded as TNAUQ_EXPECTED_BIN in the lane's settings file. Read only
# that line of that file; it may hold credentials. The probe counts a process
# only when its image is this path, the run manifest must name the same path,
# and setup-linux.sh requires it to differ from every other instance's.
TQ_EXECUTABLE=
TQ_CONFIG_PATH=/home/ubuntu/tnauqquant/config/popdex_02_config.yaml
# CONTRACT-NAMED LOGS ONLY. The runtime contract names a raw log
# YYYYMMDD_HHMMSS_<config stem>.raw.log. This pattern matches that name and
# nothing else, so another file in the same directory whose name only ends the
# same way is neither tailed as popdex-02 nor counted by its probe.
# tests/trading/test-linux-env-examples.sh holds the pattern to the first line
# of this comment.
TQ_RAW_LOG_GLOB=/home/ubuntu/tnauqquant/logs/live-runs/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9]_popdex_02_config.raw.log
TQ_RUN_MANIFEST=/home/ubuntu/tnauqquant/run-state/popdex-02/current.json
TQ_DONE_MARKER=/home/ubuntu/tnauqquant/run-state/popdex-02/current.done.json

TQ_POC_RUN_EXPECTED=1
# The lane is installed disabled and stays disabled until Wan has run one
# manual test cycle. While this is 1 the probe reports run_expected=0, so a
# stopped lane raises nothing and the manual test cycle shows as shadow
# TradingUnexpectedProcess. Set 0 with setup-linux.sh add before the lane is
# enabled for real.
TQ_STRATEGY_DISABLED=1
TQ_REQUIRE_RUNTIME_CONTRACT=1
TQ_TIMEZONE=Asia/Taipei
TQ_TEXTFILE_DIR=/var/lib/skyeye-trading/textfile
TQ_TEXTFILE_NAME=tnauqquant-popdex-02.prom
# UNVERIFIED on the host, operator fills in as EXECUTOR=popdex: EXECUTOR is
# routing.accounts[0].name in popdex_02_config.yaml, which also appears as
# executor=... in the lane's raw log. The producer reports popdex-main, so the
# value is popdex-main=popdex. popdex-btc uses the same executor name (the
# config was copied) and that is not a conflict: this map belongs to this
# instance only, the probe reads only this lane's raw log, and the two lanes
# are told apart by strategy and instance.
TQ_EXECUTOR_MAP=
TQ_SIDECAR_REQUIRED=0
TQ_TEXTFILE_MODE=640

TQ_PROBE_USER=ubuntu
TQ_PROBE_GROUP=ubuntu
TQ_ALLOY_USER=alloy
TQ_ALLOY_GROUP=alloy
