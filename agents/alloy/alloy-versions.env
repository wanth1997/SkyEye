# Grafana Alloy versions the SkyEye agent configs are tested against.
#
# Every installer reads the installed Alloy's version before it changes
# anything and refuses one that is not listed for its platform.
# tests/alloy/test-alloy-versions.sh validates every config template against
# every version here, using the images below, so a version is only listed once
# that test passes with it. To add one, see "Alloy versions" in
# agents/alloy/README.md.
#
# bash sources this file: keep it to plain NAME="value" lines.

# setup.sh and trading/setup-linux.sh.
SKYEYE_ALLOY_LINUX_VERSIONS="1.16.3 1.18.1"

# trading/setup-macos.sh. 1.16.3 rejects the action_on_duplicate_timestamp
# attribute in trading/config-macos.alloy.tmpl.
SKYEYE_ALLOY_MACOS_VERSIONS="1.18.1"

# The apt package setup.sh installs, and then holds, on a host without Alloy.
SKYEYE_ALLOY_APT_VERSION="1.18.1-1"

# One image per listed version, pinned by digest. Only the tests use these.
SKYEYE_ALLOY_TEST_IMAGES="grafana/alloy:v1.16.3@sha256:84b76d56c5943025515438fd45cbb5995386a0260d072c9b671dfd7f539f9c01 grafana/alloy:v1.18.1@sha256:0f4434c92b3e6cdac38bb129b344e1790c246f7b6e2eaffcc16a5fa363240e33"
